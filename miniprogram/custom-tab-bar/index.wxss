.tab-item { position: relative; z-index: 1; flex: 1; height: 100%; padding: 0; margin: 0; min-width: 0; border-radius: 999rpx; background: transparent; display: flex; align-items: center; justify-content: center; overflow: visible; line-height: 1; }
.tab-item::after { border: 0; }
.tab-icon-capsule { position: relative; display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 100%; height: 100%; border-radius: 999rpx; background: transparent; }
.tab-icon { display: block; width: 44rpx; height: 44rpx; }
.tab-icon-active { position: absolute; visibility: hidden; }
.is-lit .tab-icon-idle { visibility: hidden; }
.is-lit .tab-icon-active { visibility: visible; }

/* Each icon switches at its own edge crossing, with no color crossfade. */
.icon-entering .tab-icon-active, .icon-leaving .tab-icon-idle { --icon-before: hidden; --icon-after: visible; }
.icon-entering .tab-icon-idle, .icon-leaving .tab-icon-active { --icon-before: visible; --icon-after: hidden; }
.icons-slide-a .icon-entering .tab-icon, .icons-slide-a .icon-leaving .tab-icon,
.icons-slide-b .icon-entering .tab-icon, .icons-slide-b .icon-leaving .tab-icon {
  animation-duration: var(--icon-switch-at);
  animation-delay: var(--icon-delay);
  animation-timing-function: steps(1, end);
  animation-fill-mode: both;
}
.icons-slide-a .icon-entering .tab-icon, .icons-slide-a .icon-leaving .tab-icon { animation-name: tab-icon-contact-a; }
.icons-slide-b .icon-entering .tab-icon, .icons-slide-b .icon-leaving .tab-icon { animation-name: tab-icon-contact-b; }
@keyframes tab-icon-contact-a { from { visibility: var(--icon-before); } to { visibility: var(--icon-after); } }
@keyframes tab-icon-contact-b { from { visibility: var(--icon-before); } to { visibility: var(--icon-after); } }
