  transform: scale(var(--tab-dock-from, 1));
  transition: none;
}
.tab-dock-scale.dock-grow-a, .tab-dock-scale.dock-grow-b {
  animation-duration: 280ms;
  animation-timing-function: cubic-bezier(.22,.75,.3,1);
  animation-delay: var(--tab-dock-delay, 0ms);
  animation-fill-mode: both;
}
.tab-dock-scale.dock-grow-a { animation-name: tab-dock-grow-a; }
.tab-dock-scale.dock-grow-b { animation-name: tab-dock-grow-b; }
@keyframes tab-dock-grow-a { from { transform: scale(var(--tab-dock-from)); } to { transform: scale(1); } }
