@import "./nav-glass.wxss";
:host { display: block; }
.tab-bar-viewport { position: fixed; z-index: 100; left: 0; right: 0; bottom: 0; height: calc(144rpx + constant(safe-area-inset-bottom)); height: calc(144rpx + env(safe-area-inset-bottom)); overflow: hidden; pointer-events: none; }
.tab-dock {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 8rpx;
  bottom: max(8rpx, calc(constant(safe-area-inset-bottom) - 8rpx));
  bottom: max(8rpx, calc(env(safe-area-inset-bottom) - 8rpx));
  height: 104rpx;
  pointer-events: none;
  transition: transform 0.26s ease;
}
.tab-dock-scale { display: flex; align-items: center; gap: 16rpx; width: 100%; height: 100%; transform: scale(1); transform-origin: center bottom; transition: transform 280ms cubic-bezier(.22,.75,.3,1); pointer-events: none; }
.tab-dock-scale.is-compact { transform: scale(.8); }
@media (prefers-reduced-motion: reduce) { .tab-dock-scale { transition: none; } }
.tab-bar { position: relative; flex: 1; min-width: 0; height: 100%; padding: 10rpx; }
.tab-compose-glass { flex: 0 0 104rpx; width: 104rpx; height: 104rpx; border-radius: 50%; }
.tab-compose-glass .tab-compose-button { position: absolute; z-index: 1; inset: 0; display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; height: 100%; margin: 0; padding: 0; box-sizing: border-box; border: 0; border-radius: 50%; background: transparent; box-shadow: none; line-height: 1; }
.tab-compose-button::before, .tab-compose-button::after { content: none; display: none; border: 0; }
.compose-icon { position: relative; z-index: 1; display: block; width: 44rpx; height: 44rpx; }
.menu-open .tab-dock { transform: translateX(66.666667vw); }
.menu-instant .tab-dock, .menu-instant .tab-menu-shade { transition: none; }
.tab-menu-shade { position: absolute; z-index: 2; inset: 0; background: transparent; opacity: 0; pointer-events: none; transition: opacity 0.26s ease; }
.menu-open .tab-menu-shade { opacity: 1; pointer-events: auto; }
.tab-items { position: relative; z-index: 1; display: flex; align-items: center; height: 100%; }
.tab-indicator { position: absolute; top: 0; left: 0; height: 100%; border-radius: 999rpx; background: rgba(104, 112, 126, .16); pointer-events: none; }
.tab-indicator.is-sliding { animation-name: tab-indicator-slide; animation-timing-function: cubic-bezier(.22, .75, .3, 1); animation-fill-mode: both; }
@keyframes tab-indicator-slide { from { transform: translateX(var(--tab-slide-from)); } to { transform: translateX(var(--tab-slide-to)); } }
@media (prefers-reduced-motion: reduce) { .tab-indicator.is-sliding { animation: none; } }
.tab-item { position: relative; z-index: 1; flex: 1; height: 100%; padding: 0; margin: 0; min-width: 0; border-radius: 999rpx; background: transparent; display: flex; align-items: center; justify-content: center; overflow: visible; line-height: 1; }
.tab-item::after { border: 0; }
.tab-item-pressed { opacity: 0.65; }
.tab-icon-capsule { position: relative; display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 100%; height: 100%; border-radius: 999rpx; background: transparent; }
.tab-icon { display: block; width: 44rpx; height: 44rpx; }
.tab-icon-active { position: absolute; opacity: 0; }
.is-selected .tab-icon-idle { opacity: 0; }
.is-selected .tab-icon-active { opacity: 1; }
