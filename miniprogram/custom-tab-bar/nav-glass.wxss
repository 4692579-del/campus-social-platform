/* 用户提供的第三版玻璃：独立表面层、方向性内壁及轻环境投影。 */
.nav-glass {
  --glass-alpha: 0.58;
  --glass-blur: 30px;
  --glass-saturation: 180%;
  position: relative;
  box-sizing: border-box;
  isolation: isolate;
  overflow: hidden;
  border-radius: 999rpx;
  border: 0;
  pointer-events: auto;
  background: linear-gradient(145deg, rgba(255, 255, 255, .92) 0%, rgba(248, 249, 251, .86) 42%, rgba(242, 244, 247, .88) 100%);
  box-shadow: 0 2rpx 5rpx rgba(20, 28, 40, .06), 0 10rpx 30rpx rgba(20, 28, 40, .05);
}

.nav-glass::before {
  content: '';
  position: absolute;
  z-index: -2;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  background:
    radial-gradient(90% 150% at 18% -35%, rgba(255, 255, 255, .34) 0%, rgba(255, 255, 255, .12) 42%, rgba(255, 255, 255, 0) 72%),
    linear-gradient(165deg, rgba(255, 255, 255, calc(var(--glass-alpha) + .10)) 0%, rgba(250, 251, 253, var(--glass-alpha)) 38%, rgba(242, 245, 249, calc(var(--glass-alpha) - .04)) 72%, rgba(255, 255, 255, calc(var(--glass-alpha) + .03)) 100%);
  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(1.04);
  backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)) brightness(1.04);
}

.nav-glass::after {
  content: '';
  position: absolute;
  z-index: 5;
  inset: 0;
  box-sizing: border-box;
  /* 光学边缘始终铺满材质容器，发布区域由同款view承载。 */
  width: auto;
  height: auto;
  transform: none;
  -webkit-transform: none;
  border-radius: inherit;
  pointer-events: none;
  border: 1rpx solid rgba(80, 91, 108, .10);
  box-shadow:
    inset 0 1.5rpx 1rpx rgba(255, 255, 255, .72),
    inset 1.5rpx 1rpx 2rpx rgba(255, 255, 255, .32),
    inset 0 -1.5rpx 2rpx rgba(70, 82, 99, .12),
    inset 0 0 8rpx rgba(255, 255, 255, .10);
}

/* 使用独立模糊层时清除主体降级底色，避免模糊只采样到不透明白底。 */
@supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
  .nav-glass { background: transparent; }
}
