/* Adapted from dev-okazawa/liquid-glass-nav (MIT), see LICENSE-liquid-glass-nav.txt. */
.nav-glass {
  position: relative;
  box-sizing: border-box;
  border-radius: 999rpx;
  pointer-events: auto;
}

.nav-glass-surface,
.nav-glass-effect,
.nav-glass-tint,
.nav-glass-shine,
.tab-indicator-refraction,
.tab-indicator-tint,
.tab-indicator-shine {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
}

.nav-glass-surface {
  /* The optical surface can bloom without changing layout or hit targets. */
  transition: transform 250ms cubic-bezier(.34, 1.4, .4, 1);
}

.nav-glass.is-glass-pressed .nav-glass-surface { transform: scale(1.015); }
.tab-compose-glass.is-glass-pressed .nav-glass-surface { transform: scale(1.06); }

.nav-glass-effect,
.tab-indicator-refraction { display: var(--dock-optics-display, block); }
.nav-glass-effect {
  overflow: hidden;
  background: rgba(250, 251, 253, .9);
  background: rgba(250, 251, 253, var(--dock-glass-fallback, .9));
}
.nav-glass-tint {
  opacity: var(--dock-glass-strength, 1);
  background: radial-gradient(80% 140% at 50% 45%, rgba(255, 255, 255, .22), transparent),
    linear-gradient(180deg, rgba(91, 101, 117, .105), rgba(255, 255, 255, .16));
}
.nav-glass-shine {
  box-sizing: border-box;
  border: 1rpx solid rgba(87, 99, 116, .10);
  box-shadow: 0 5rpx 18rpx rgba(20, 28, 40, .13), inset 0 2rpx 2rpx rgba(255, 255, 255, .68),
    inset 0 -1rpx 2rpx rgba(255, 255, 255, .45);
}

.tab-indicator-glass {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 999rpx;
  transform-origin: center;
  transition: transform 640ms cubic-bezier(.18, 1.25, .22, 1);
}
.tab-indicator-glass.is-lens-pressed { transform: scaleX(1.42) scaleY(1.32); }
.tab-indicator-refraction {
  overflow: hidden;
  opacity: var(--dock-glass-strength, 1);
}
.tab-indicator-tint {
  background: rgba(104, 112, 126, .16);
  transition: background-color 420ms ease;
}
.is-lens-pressed .tab-indicator-tint { background-color: rgba(104, 112, 126, .21); }
.tab-indicator-shine {
  opacity: 0;
  background: radial-gradient(120% 140% at 24% 18%, rgba(255, 255, 255, .22), rgba(255, 255, 255, .06) 60%, rgba(22, 32, 50, .08));
  box-shadow: inset 1px 1px 1.5px rgba(255, 255, 255, .50), inset -1px -1px 1.5px rgba(255, 255, 255, .18),
    inset -3px -3px 5px rgba(22, 32, 50, .08);
  transition: opacity 360ms ease;
}
.tab-indicator-shine::after,
.tab-indicator-shine::before { content: ''; position: absolute; border-radius: 999rpx; pointer-events: none; }
.tab-indicator-shine::after {
  inset: 8rpx 15rpx auto 12rpx;
  height: 26rpx;
  background: linear-gradient(120deg, rgba(255, 255, 255, .48), rgba(255, 255, 255, .05) 70%);
  transform: translateY(-2px) scaleX(.85);
  transform-origin: left center;
  transition: transform 520ms cubic-bezier(.18, 1.25, .22, 1);
}
.tab-indicator-shine::before {
  inset: auto 8rpx 6rpx auto;
  width: 40%;
  height: 14rpx;
  background: linear-gradient(180deg, transparent, rgba(255, 255, 255, .33));
}
.is-lens-pressed .tab-indicator-shine { opacity: 1; }
.is-lens-pressed .tab-indicator-shine::after { transform: translateY(-1px) scaleX(1.05); }

@supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
  .nav-glass-effect {
    background: rgba(250, 251, 253, .47);
    background: rgba(250, 251, 253, var(--dock-glass-fill, .47));
    -webkit-backdrop-filter: var(--dock-surface-filter, blur(1.5px) saturate(140%) contrast(1.02));
    backdrop-filter: var(--dock-surface-filter, blur(1.5px) saturate(140%) contrast(1.02));
  }
  .tab-indicator-refraction {
    -webkit-backdrop-filter: var(--dock-lens-filter, blur(1.5px) saturate(145%) contrast(1.02));
    backdrop-filter: var(--dock-lens-filter, blur(1.5px) saturate(145%) contrast(1.02));
  }
}

/* WXSS has no inline SVG defs. A self-contained reference carries the original
   noise/displacement graph on engines that accept SVG backdrop filters. */
@supports (backdrop-filter: url("#bottom-tab-liquid-lens")) {
  .tab-indicator-refraction {
    backdrop-filter: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cfilter%20id%3D%22bottom-tab-liquid-lens%22%20color-interpolation-filters%3D%22sRGB%22%3E%3CfeTurbulence%20type%3D%22fractalNoise%22%20baseFrequency%3D%220.018%200.026%22%20numOctaves%3D%221%22%20seed%3D%2211%22%20result%3D%22lensNoise%22%2F%3E%3CfeDisplacementMap%20in%3D%22SourceGraphic%22%20in2%3D%22lensNoise%22%20scale%3D%2218%22%20xChannelSelector%3D%22R%22%20yChannelSelector%3D%22G%22%2F%3E%3C%2Ffilter%3E%3C%2Fsvg%3E#bottom-tab-liquid-lens") var(--dock-lens-filter, blur(1.5px) saturate(145%) contrast(1.02));
  }
}

@media (prefers-reduced-motion: reduce) {
  .nav-glass-surface, .tab-indicator-glass, .tab-indicator-tint, .tab-indicator-shine, .tab-indicator-shine::after { transition: none; }
  .nav-glass.is-glass-pressed .nav-glass-surface, .tab-indicator-glass.is-lens-pressed { transform: none; }
}
