/**app.wxss**/
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}


page {
  background: #f6f6f6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

/* 校园业务页共用的基础样式。cs 前缀避免影响保留的 QuickStart 页面。 */
.cs-page { padding: 32rpx; color: #252525; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; }
.cs-card { background: #fff; border-radius: 28rpx; padding: 32rpx; margin-bottom: 24rpx; }
.cs-title { font-size: 34rpx; font-weight: 600; }
.cs-muted { color: #777; font-size: 26rpx; line-height: 1.7; }
.cs-primary { width: 100%; box-sizing: border-box; background: #4775fa; color: #fff; font-size: 30rpx; font-weight: 600; border-radius: 20rpx; margin: 0; }
.cs-secondary { width: 100%; box-sizing: border-box; background: #f4f4f4; color: #555; font-size: 28rpx; border-radius: 20rpx; margin: 0; }
.cs-error { padding: 24rpx; background: #fff2ed; color: #a44127; border-radius: 20rpx; font-size: 26rpx; margin-bottom: 24rpx; }
.cs-tag { display: inline-block; background: #eef3ff; color: #3d63c6; border-radius: 10rpx; padding: 6rpx 14rpx; font-size: 22rpx; }
.cs-avatar { width: 112rpx; height: 112rpx; border-radius: 50%; background: #f3f3f3; }

/* 自定义底栏固定在屏幕底部，为内容与设备安全区预留空间。 */
.has-tab-bar { padding-bottom: calc(120rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(120rpx + env(safe-area-inset-bottom)); }
.tab-placeholder { min-height: 65vh; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; }
.tab-placeholder-icon { width: 88rpx; height: 88rpx; margin-bottom: 28rpx; opacity: 0.65; }
.tab-placeholder-title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
