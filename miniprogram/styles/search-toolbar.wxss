/* 搜索入口和结果共用一行尺寸；点击区用 view，避开原生 button 的 mini 内边距。 */
.search-toolbar { display:flex; align-items:center; flex-wrap:nowrap; width:100%; height:80rpx; box-sizing:border-box; }
.search-toolbar-field { flex:1 1 0%; width:0; min-width:0; }
.search-toolbar-action { display:flex; align-items:center; justify-content:center; flex-shrink:0; height:80rpx; margin:0; padding:0; box-sizing:border-box; }
.search-toolbar-submit { flex:0 0 84rpx; width:84rpx; margin-left:12rpx; color:#4775fa; font-size:28rpx; font-weight:600; }
.search-toolbar-label { display:block; flex-shrink:0; font-size:28rpx; line-height:40rpx; white-space:nowrap; word-break:keep-all; letter-spacing:0; }
.search-toolbar-back { flex:0 0 56rpx; width:56rpx; margin-right:8rpx; }
.search-toolbar-back-icon { display:block; width:34rpx; height:34rpx; }
