@import "./login-sheet.wxss";
page { background: #fff; }
.square-page { min-height: 100vh; box-sizing: border-box; background: #fff; color: #171b20; }
.square-nav { position: fixed; z-index: 100; top: 0; left: 0; right: 0; background: rgba(255, 255, 255, 0.96); border-bottom: 1rpx solid #edf0f3; box-sizing: border-box; }
.square-nav-title { position: absolute; left: 120rpx; right: 120rpx; text-align: center; font-size: 32rpx; font-weight: 700; white-space: nowrap; }
.square-page .square-back { position: absolute; left: 20rpx; display: flex; align-items: center; justify-content: center; width: 72rpx; min-width: 0; margin: 0; padding: 0; background: transparent; border: 0; border-radius: 50%; line-height: 1; }
.square-back image { width: 36rpx; height: 36rpx; }
.square-page button::after { border: 0; }
.square-notice { padding: 24rpx 28rpx; color: #87919c; font-size: 26rpx; line-height: 1.7; text-align: center; }
.square-page .inline-error { margin: 24rpx 28rpx; padding: 20rpx 24rpx; border-radius: 16rpx; background: #fff4f1; color: #a44130; font-size: 26rpx; line-height: 1.6; }
.square-page .retry-link { display: inline-flex; margin: 12rpx 0 0; padding: 0; background: transparent; color: #4775fa; font-size: 26rpx; line-height: 1.6; }
