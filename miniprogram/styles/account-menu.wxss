.profile-menu-layer { position: fixed; z-index: 1000; inset: 0; visibility: hidden; pointer-events: none; transition: visibility 0s linear 0.26s; }
.profile-menu-layer.is-open { visibility: visible; pointer-events: auto; transition-delay: 0s; }
.menu-backdrop { position: absolute; top: 0; left: 0; right: 0; bottom: calc(88rpx + constant(safe-area-inset-bottom) + 1rpx); bottom: calc(88rpx + env(safe-area-inset-bottom) + 1rpx); background: transparent; opacity: 0; transition: opacity 0.26s ease; }
.is-open .menu-backdrop { opacity: 1; }
.menu-panel { position: absolute; left: 0; top: 0; bottom: 0; width: 66.666667vw; display: flex; flex-direction: column; box-sizing: border-box; background: #fff; transform: translateX(-100%); transition: transform 0.26s ease; }
.menu-panel::after { content: ''; position: absolute; z-index: 2; top: 0; right: 0; bottom: 0; width: 44rpx; background: linear-gradient(to right, rgba(15, 23, 37, 0), rgba(15, 23, 37, 0.025) 45%, rgba(15, 23, 37, 0.12)); pointer-events: none; }
.is-open .menu-panel { transform: translateX(0); }
.menu-account { padding: 0 48rpx 20rpx; flex-shrink: 0; }
.menu-avatar { display: block; width: 84rpx; height: 84rpx; border-radius: 50%; background: #f1f3f5; }
.menu-nickname { margin-top: 16rpx; font-size: 34rpx; font-weight: 700; color: #171b20; line-height: 1.45; overflow-wrap: break-word; }
.menu-account-id { margin-top: 10rpx; font-size: 25rpx; color: #687580; line-height: 1.6; overflow-wrap: break-word; font-variant-numeric: tabular-nums; }
.menu-account-stats { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx 18rpx; margin-top: 16rpx; font-size: 25rpx; line-height: 1.6; color: #687580; }
.menu-account-stats > view { white-space: nowrap; }
.menu-stat-count { margin-right: 5rpx; font-weight: 650; color: #171b20; }
.menu-scroll { flex: 1; height: 0; min-height: 0; }
.menu-items { padding: 4rpx 48rpx 0; }
.account-menu .menu-item { display: flex; align-items: center; gap: 28rpx; width: 100%; min-width: 0; min-height: 94rpx; margin: 0; padding: 18rpx 0; box-sizing: border-box; border: 0; border-radius: 12rpx; background: transparent; color: #171b20; font-size: 36rpx; font-weight: 650; line-height: 1.5; text-align: left; white-space: nowrap; }
.menu-item text { font-size: inherit; font-weight: inherit; line-height: inherit; }
.menu-item-icon { display: block; width: 32rpx; height: 32rpx; flex-shrink: 0; }
.menu-utilities { margin: 48rpx 48rpx 0; padding-top: 48rpx; border-top: 1rpx solid #e4e7eb; }
.menu-utility-section { padding: 8rpx 0; }
.menu-utility-section:first-child { padding-top: 0; }
.account-menu .menu-utility-item { min-height: 78rpx; padding: 14rpx 0; font-size: 29rpx; font-weight: 500; color: #171b20; }
.menu-footer { display: flex; justify-content: center; padding: 28rpx 48rpx calc(28rpx + env(safe-area-inset-bottom)); }
.account-menu .menu-logout { display: flex; align-items: center; justify-content: center; width: 208rpx; max-width: 100%; min-width: 0; height: 72rpx; margin: 0; padding: 0 8rpx; border: 0; border-radius: 16rpx; box-sizing: border-box; background: #e9e9e9; color: #d84a4a; font-size: 29rpx; font-weight: 600; line-height: 1; white-space: nowrap; }
.account-menu .menu-logout[disabled] { color: #d84a4a; background: #e9e9e9; opacity: 0.45; }
.account-menu button::after { border: 0; }
