/* 两处胶囊共用同一形象；眼睛独立变形，不压扁整张脸。 */
.xiaocui-icon { position: relative; display: block; flex: 0 0 auto; width: 32rpx; height: 32rpx; pointer-events: none; }
.xiaocui-icon-float { position: absolute; top: 0; left: 0; width: 100%; height: 100%; animation: xiaocui-capsule-float 3.6s ease-in-out infinite; }
.xiaocui-icon .xiaocui-icon-body { position: absolute; top: 0; left: 0; display: block; width: 100%; height: 100%; }
.xiaocui-icon-eye { position: absolute; top: 24%; width: 11%; height: 23%; border-radius: 999rpx; background: #fff; }
.xiaocui-icon-eye-left { left: 19%; }
.xiaocui-icon-eye-right { left: 42%; transform-origin: 50% 50%; animation: xiaocui-capsule-wink 2s ease-in-out infinite; }
@keyframes xiaocui-capsule-float { 0%, 100% { transform: translateY(2rpx); } 50% { transform: translateY(-2rpx); } }
@keyframes xiaocui-capsule-wink {
  0%, 70%, 92%, 100% { transform: scaleY(1); }
  80%, 82% { transform: scaleY(.13) rotate(-8deg); }
}
@media (prefers-reduced-motion: reduce) {
  .xiaocui-icon-float, .xiaocui-icon-eye-right { animation: none; }
}
