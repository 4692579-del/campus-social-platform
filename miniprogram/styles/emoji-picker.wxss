.emoji-picker { display: block; box-sizing: border-box; width: 100%; height: 236rpx; max-height: 28vh; background: #f5f6f8; border-top: 1rpx solid #edf0f3; }
.emoji-picker-grid { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); padding: 10rpx 20rpx; }
.emoji-picker-grid .emoji-picker-choice { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; height: 72rpx; margin: 0; padding: 0; background: transparent; border-radius: 12rpx; font-size: 40rpx; font-weight: 400; line-height: 1; }
.emoji-picker-choice::after { border: 0; }
.emoji-picker-grid .emoji-picker-choice.button-hover { background: #e6ebf4; }
