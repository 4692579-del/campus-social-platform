<template name="login-sheet">
<view class="account-login profile-auth-layer {{authChecking || loginSheetOpen ? 'is-active' : ''}} {{loginSheetOpen ? 'has-sheet' : ''}}" catchtap="stopMenuEvent" catchtouchmove="stopMenuEvent">
    <view class="auth-mask"></view>
    <view wx:if="{{authChecking && !loginSheetOpen}}" class="auth-checking">正在确认登录状态…</view>
    <view class="login-sheet" aria-role="dialog" aria-modal="true" aria-label="微信登录" aria-hidden="{{!loginSheetOpen}}">
      <view class="login-sheet-title">微信登录</view>
      <view class="login-sheet-description">登录萃，开启你的校园生活。</view>
      <view wx:if="{{error}}" class="login-sheet-error">{{error}}</view>
      <button size="mini" class="login-sheet-primary" bindtap="login" loading="{{loading}}" disabled="{{loading}}">{{loading ? '正在登录…' : '微信登录'}}</button>
      <button size="mini" class="login-sheet-cancel" bindtap="cancelLogin">暂不登录，返回首页</button>
    </view>
  </view>
</template>
