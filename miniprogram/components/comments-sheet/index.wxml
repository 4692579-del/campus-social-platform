<import src="../../templates/xiaocui-icon.wxml" />
<template name="comment">
  <view id="comment-{{row._id}}" class="comment-row {{child ? 'is-child' : ''}}" data-id="{{row._id}}" bindtap="selectReply">
    <image class="comment-avatar {{row.author.isAI ? 'is-ai' : ''}}" src="{{row.author.isAI ? '/images/ai/xiaocui.jpg' : (row.author.avatarFileID || '/images/avatar.png')}}" mode="aspectFill" />
    <view class="comment-main">
      <view class="comment-heading"><text>{{row.author.nickname}}</text><text wx:if="{{row.author.isAI}}" class="comment-ai-badge">AI</text><image wx:if="{{row.author.verified}}" class="comment-badge" src="/images/verification/verified.png" /><text wx:if="{{row.addressed}}" class="comment-address">回复 {{row.replyToName}}</text><button wx:if="{{!row.pending}}" class="comment-more" data-id="{{row._id}}" catchtap="manageComment" aria-label="评论更多操作"><image src="/images/interface/menu-two.svg" mode="aspectFit" /></button></view>
      <view wx:if="{{row.folded}}" class="comment-folded"><image src="/images/interface/alert-circle-muted.svg" /><text>该评论已折叠</text></view>
      <text wx:else class="comment-text">{{row.content}}</text>
      <view class="comment-meta">
        <text class="comment-time">{{row.pending ? '发送中…' : row.timeText}}</text><text wx:if="{{!row.folded && !row.pending}}" class="comment-reply-label">回复</text>
        <view wx:if="{{!row.pending}}" class="comment-actions">
          <button class="comment-action {{row.liked ? 'is-liked' : ''}}" data-id="{{row._id}}" data-kind="like" catchtap="reactComment" aria-label="{{row.liked ? '取消点赞' : '点赞评论'}}"><image src="/images/interface/heart{{row.liked ? '-active' : '-muted'}}.svg" /><text>{{row.likeCount || 0}}</text></button>
          <button class="comment-action comment-dislike" data-id="{{row._id}}" data-kind="fold" catchtap="reactComment" aria-label="{{row.folded ? '恢复此评论及回复' : '仅为我折叠此评论及回复'}}"><image src="/images/interface/heart-broken{{row.folded ? '-active' : '-muted'}}.svg" /></button>
        </view>
      </view>
      <view wx:if="{{(row.aiStatus === 'queued' || row.aiStatus === 'processing' || row.aiStatus === 'failed' || row.aiStatus === 'unavailable') && !row.folded && !row.pending}}" class="comment-ai-status" catchtap="stopEvent">
        <text wx:if="{{row.aiStatus === 'queued' || row.aiStatus === 'processing'}}">小萃正在思考…</text>
        <block wx:elif="{{row.aiStatus === 'failed' || row.aiStatus === 'unavailable'}}"><text>{{row.aiMessage || '小萃暂时无法回复'}}</text><button wx:if="{{row.aiCanRetry}}" data-id="{{row._id}}" catchtap="retryAI">重试</button></block>
      </view>
    </view>
  </view>
</template>
<view class="comments-layer {{embedded ? 'is-embedded' : ''}}" style="top: {{embedded ? topOffset : 0}}px;" catchtouchmove="stopEvent">
  <view wx:if="{{!embedded}}" class="comments-mask" bindtap="close"></view>
  <view class="comments-panel {{dragging ? 'is-dragging' : ''}} {{embedded ? 'is-embedded' : ''}}" style="{{embedded ? 'top: 0; bottom: ' + keyboardHeight + 'px;' : 'top: ' + (keyboardHeight ? keyboardTop : sheetTop) + 'px; height: ' + (viewportHeight - (keyboardHeight ? keyboardTop : sheetTop) - keyboardHeight) + 'px;'}}" aria-role="{{embedded ? 'region' : 'dialog'}}" aria-label="动态评论">
    <view wx:if="{{!embedded}}" class="comments-grabber" catchtouchstart="dragStart" catchtouchmove="dragMove" catchtouchend="dragEnd" catchtouchcancel="dragCancel" aria-label="上下拖动可切换评论区高度"><view class="comments-grabber-bar"></view></view>
    <view wx:if="{{!embedded}}" class="comments-header"><text>回复</text><view class="comments-header-actions"><button bindtap="toggleExpanded" aria-label="{{expanded ? '缩小回复面板' : '展开回复面板'}}" aria-expanded="{{expanded}}"><image src="/images/interface/{{expanded ? 'minimize' : 'maximize'}}.svg" mode="aspectFit" /></button><button bindtap="close" disabled="{{sending}}" aria-label="关闭回复面板"><image src="/images/interface/x.svg" mode="aspectFit" /></button></view></view>
    <view class="comments-body">
      <scroll-view class="comments-list" scroll-y scroll-into-view="{{scrollIntoView}}" scroll-with-animation bindscrolltolower="loadMore" lower-threshold="100">
        <block wx:if="{{embedded}}"><slot name="post"></slot><view class="comments-header embedded-comments-title"><text>回复</text></view></block>
        <view wx:if="{{error}}" class="comments-error">{{error}}<button bindtap="retry">重试</button></view>
        <view wx:if="{{loading}}" class="comments-status">正在读取评论…</view>
        <view wx:elif="{{!items.length && !error}}" class="comments-status">还没有评论，说说你的想法吧</view>
        <view wx:for="{{items}}" wx:key="_id" class="comment-group">
          <template is="comment" data="{{row: item, child: false}}" />
          <view wx:if="{{!item.folded}}" class="comment-thread">
            <block wx:if="{{!item.threadOpen}}"><template wx:for="{{item.freshChildren}}" wx:for-item="fresh" wx:key="_id" is="comment" data="{{row: fresh, child: true}}" /></block>
            <button wx:if="{{item.showExpand}}" class="thread-toggle" data-id="{{item._id}}" bindtap="toggleThread"><view class="thread-line"></view><text>展开 {{item.remainingCount}} 条回复</text><image src="/images/interface/chevron-down.svg" /></button>
            <block wx:if="{{item.threadOpen}}">
              <template wx:for="{{item.visibleChildren}}" wx:for-item="child" wx:key="_id" is="comment" data="{{row: child, child: true}}" />
              <view wx:if="{{item.threadLoading}}" class="thread-status">正在读取回复…</view>
              <view wx:elif="{{item.threadError}}" class="thread-error">{{item.threadError}}<button data-id="{{item._id}}" bindtap="retryChildren">重试</button></view>
              <button wx:elif="{{item.threadHasMore}}" class="thread-toggle" data-id="{{item._id}}" bindtap="moreChildren"><view class="thread-line"></view><text>展开更多回复</text><image src="/images/interface/chevron-down.svg" /></button>
            </block>
            <button wx:if="{{item.showCollapse}}" class="thread-toggle" data-id="{{item._id}}" bindtap="collapseThread"><view class="thread-line"></view><text>收起</text><image class="chevron-up" src="/images/interface/chevron-down.svg" /></button>
          </view>
        </view>
        <view wx:if="{{loadingMore}}" class="comments-status">正在加载…</view>
        <button wx:elif="{{hasMore}}" class="comments-more" bindtap="loadMore">查看更多评论</button>
      </scroll-view>
    </view>
    <view class="comments-footer">
      <view wx:if="{{sendError}}" class="comments-send-error">{{sendError}}</view>
      <view wx:if="{{replyTarget}}" class="comment-target"><text>回复 {{replyTarget.nickname}}</text><button bindtap="cancelReply" disabled="{{sending}}" aria-label="取消回复，改为评论动态"><image src="/images/interface/x.svg" /></button></view>
      <view class="comment-composer {{count || sending ? 'has-content' : ''}}" style="padding-bottom: {{keyboardHeight ? '20rpx' : 'calc(20rpx + env(safe-area-inset-bottom))'}};">
        <block wx:if="{{viewer}}">
          <view class="comment-input-pill">
            <image wx:if="{{!inputFocused && !count && !sending}}" class="composer-avatar" src="{{viewer.avatarFileID || '/images/avatar.png'}}" mode="aspectFill" aria-hidden="true" />
            <view wx:if="{{askAI}}" class="composer-ai-chip composer-ai-mention" aria-label="已选择小萃，退格可删除">@小萃</view>
            <view class="comment-entry"><input value="{{inputValue}}" cursor="{{inputCursor}}" focus="{{inputFocused}}" bindfocus="focusInput" bindblur="blurInput" bindinput="input" bindkeyboardheightchange="keyboard" maxlength="600" disabled="{{sending}}" placeholder="{{askAI ? '' : '添加回复...'}}" placeholder-class="composer-placeholder" aria-label="评论输入框" confirm-type="send" bindconfirm="send" adjust-position="{{false}}" /><text wx:if="{{askAI && !text}}" class="composer-ai-placeholder composer-placeholder">添加回复...</text></view>
            <view class="composer-tools" aria-hidden="{{count > 0 || sending}}">
              <view class="composer-tool-icons">
              <button class="composer-ai-chip composer-ask-ai" catchtap="askXiaocui" disabled="{{sending}}" aria-label="问问小萃"><template is="xiaocui-icon" /><text>问问小萃</text></button>
              <view class="composer-tool" aria-label="图片，暂未开放" catchtap="stopEvent"><image src="/images/interface/comment-image.svg" mode="aspectFit" /></view>
              <view class="composer-tool" aria-label="贴纸，暂未开放" catchtap="stopEvent"><image src="/images/interface/comment-sticker.svg" mode="aspectFit" /></view>
              <view class="composer-tool" aria-label="GIF，暂未开放" catchtap="stopEvent"><image src="/images/interface/comment-gif.svg" mode="aspectFit" /></view>
              </view>
            </view>
          </view>
          <view class="composer-send-slot" aria-hidden="{{!count && !sending}}"><button class="comment-send" bindtap="send" loading="{{sending}}" disabled="{{sending || !canSend}}" aria-label="{{sending ? '正在发送评论' : '发送评论'}}"><image wx:if="{{!sending}}" src="/images/interface/arrow-up-white.svg" mode="aspectFit" /></button></view>
        </block>
        <button wx:else class="comment-login" bindtap="login">登录后发表评论</button>
      </view>
    </view>
  </view>
</view>
