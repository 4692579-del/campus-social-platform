<import src="../../templates/xiaocui-icon.wxml" />
<template name="comment">
  <view id="comment-{{row._id}}" class="comment-row {{row.motionLikeClass}} {{row.motionFoldClass}} {{row.folded ? 'is-personally-folded' : ''}} {{child ? 'is-child' : ''}} {{row.highlighted ? 'is-located' : ''}}" data-id="{{row._id}}" bindtap="{{history ? 'openComment' : 'selectReply'}}">
    <image data-id="{{row._id}}" catchtap="viewCommentAuthor" class="comment-avatar avatar-outline {{row.author.isAI ? 'is-ai' : ''}}" src="{{row.author.isAI ? '/images/ai/xiaocui.jpg' : (row.author.avatarFileID || '/images/avatar.png')}}" mode="aspectFill" />
    <view class="comment-main">
      <view class="comment-heading"><text>{{row.author.nickname}}</text><text wx:if="{{row.author.isAI}}" class="comment-ai-badge">AI</text><image wx:if="{{row.author.verified || row.author.officialVerified}}" class="comment-badge" src="/images/verification/verified.png" /><text wx:if="{{row.addressed}}" class="comment-address">回复 {{row.replyToName}}</text><button wx:if="{{!row.pending && !historyReadOnly}}" class="comment-more" data-id="{{row._id}}" catchtap="manageComment" aria-label="评论更多操作"><image src="/images/interface/menu-two.svg" mode="aspectFit" /></button></view>
      <view class="comment-content-grid {{row.folded ? 'is-folded' : ''}}" aria-hidden="{{row.folded}}"><view class="comment-content-inner">
        <text wx:if="{{row.content}}" class="comment-text">{{row.content}}</text>
        <view wx:if="{{row.images.length}}" class="comment-image-grid">
          <view wx:for="{{row.images}}" wx:for-item="photo" wx:key="*this" class="comment-image-cell" data-id="{{row._id}}" data-index="{{index}}" catchtap="previewCommentImages"><media-image class="comment-image-preview" src="{{photo}}" mode="aspectFill" /></view>
        </view>
      </view></view>
      <view class="comment-folded-grid {{row.folded ? 'is-folded' : ''}}" aria-hidden="{{!row.folded}}"><view class="comment-folded-inner"><view class="comment-folded"><image src="/images/interface/alert-circle-muted.svg" /><text>该评论已折叠</text></view></view></view>
      <view class="comment-meta">
        <text class="comment-time">{{row.pending ? '发送中…' : row.timeText}}</text><text wx:if="{{!row.pending && !closed}}" class="comment-reply-label" data-id="{{row._id}}" catchtap="selectReply">回复</text>
        <view wx:if="{{!row.pending && !row.hiddenByAncestor}}" class="comment-actions">
          <button class="comment-action {{row.liked ? 'is-liked' : ''}}" data-id="{{row._id}}" data-kind="like" catchtap="reactComment" aria-label="{{row.liked ? '取消点赞' : '点赞评论'}}"><view class="comment-like-stage"><image class="comment-like-glyph comment-like-outline" src="/images/interface/heart-muted.svg" /><image class="comment-like-glyph comment-like-solid" src="/images/interface/heart-solid.svg" /></view><text>{{row.likeCount || 0}}</text></button>
          <button class="comment-action comment-dislike" data-id="{{row._id}}" data-kind="fold" catchtap="reactComment" aria-label="{{row.folded ? '恢复此评论及回复' : '仅为我折叠此评论及回复'}}"><view class="comment-break-stage"><image class="comment-break-glyph comment-break-outline" src="/images/interface/heart-broken-muted.svg" /><image class="comment-break-glyph comment-break-solid" src="/images/interface/heart-broken-active.svg" /><view wx:if="{{row.motionFoldClass}}" class="comment-break-float" aria-hidden="true"><image class="comment-break-half comment-break-left" src="/images/comment-actions/break-left.svg" /><image class="comment-break-half comment-break-right" src="/images/comment-actions/break-right.svg" /><view class="comment-break-shard shard-1"></view><view class="comment-break-shard shard-2"></view><view class="comment-break-shard shard-3"></view><view class="comment-break-shard shard-4"></view><view class="comment-break-shard shard-5"></view></view></view></button>
        </view>
      </view>
      <view class="comment-content-grid comment-ai-status-grid {{row.folded ? 'is-folded' : ''}}" aria-hidden="{{row.folded}}"><view class="comment-content-inner"><view wx:if="{{(row.aiStatus === 'queued' || row.aiStatus === 'processing' || row.aiStatus === 'failed' || row.aiStatus === 'unavailable') && !row.pending}}" class="comment-ai-status" catchtap="stopEvent">
        <text wx:if="{{row.aiStatus === 'queued' || row.aiStatus === 'processing'}}">小萃正在思考…</text>
        <block wx:elif="{{row.aiStatus === 'failed' || row.aiStatus === 'unavailable'}}"><text>{{row.aiMessage || '小萃暂时无法回复'}}</text><button wx:if="{{row.aiCanRetry}}" data-id="{{row._id}}" catchtap="retryAI">重试</button></block>
      </view></view></view>
    </view>
  </view>
</template>
<view class="comments-layer {{embedded ? 'is-embedded' : ''}} {{nativeTextareaMetrics ? 'has-native-textarea-metrics' : ''}}" style="top: {{embedded ? topOffset : 0}}px;">
  <view wx:if="{{!embedded}}" class="comments-mask" bindtap="close" catchtouchmove="stopEvent"></view>
  <view class="comments-panel {{dragging ? 'is-dragging' : ''}} {{inputFocused || keyboardHeight ? 'is-editing' : ''}} {{embedded ? 'is-embedded' : ''}}" style="{{embedded ? 'top: 0; bottom: ' + keyboardHeight + 'px;' : 'top: ' + (keyboardHeight ? keyboardTop : sheetTop) + 'px; height: ' + (viewportHeight - (keyboardHeight ? keyboardTop : sheetTop) - keyboardHeight) + 'px;'}}" aria-role="{{embedded ? 'region' : 'dialog'}}" aria-label="动态评论">
    <view wx:if="{{!embedded}}" class="comments-grabber" catchtouchstart="dragStart" catchtouchmove="dragMove" catchtouchend="dragEnd" catchtouchcancel="dragCancel" aria-label="上下拖动可切换评论区高度"><view class="comments-grabber-bar"></view></view>
    <view wx:if="{{!embedded}}" class="comments-header"><text>回复</text><view class="comments-header-actions"><button bindtap="toggleExpanded" aria-label="{{expanded ? '缩小回复面板' : '展开回复面板'}}" aria-expanded="{{expanded}}"><image src="/images/interface/{{expanded ? 'minimize' : 'maximize'}}.svg" mode="aspectFit" /></button><button bindtap="close" disabled="{{sending || choosingImages}}" aria-label="关闭回复面板"><image src="/images/interface/x.svg" mode="aspectFit" /></button></view></view>
    <view class="comments-body">
      <scroll-view class="comments-list" scroll-y scroll-into-view="{{scrollIntoView}}" scroll-with-animation bindscrolltolower="loadMore" lower-threshold="100">
        <block wx:if="{{embedded}}"><slot name="post"></slot><view class="comments-header embedded-comments-title"><text>回复</text></view></block>
        <view wx:if="{{error}}" class="comments-error">{{error}}<button bindtap="retry">重试</button></view>
        <view wx:if="{{locateError}}" class="comments-error">{{locateError}}<button bindtap="retryLocate">重新定位</button></view>
        <view wx:if="{{loading}}" class="comments-status">正在读取评论…</view>
        <view wx:elif="{{!items.length && !error && !commentsDisabled && !commentsClosed}}" class="comments-status">还没有评论，说说你的想法吧</view>
        <view wx:for="{{items}}" wx:key="_id" class="comment-group">
          <template is="comment" data="{{row: item, child: false, closed: commentsDisabled || commentsClosed}}" />
          <view class="comment-thread-grid {{item.folded ? 'is-folded' : ''}} {{item.motionFoldClass}}" aria-hidden="{{item.folded}}"><view class="comment-thread-clip"><view class="comment-thread">
            <block wx:if="{{!item.threadOpen}}"><view wx:for="{{item.motionFreshChildren}}" wx:for-item="fresh" wx:key="_id" class="comment-nested-grid {{fresh.motionAncestorFolded ? 'is-hidden' : ''}} {{fresh.motionAncestorClass}}" aria-hidden="{{fresh.motionAncestorFolded}}"><view class="comment-nested-clip"><template is="comment" data="{{row: fresh, child: true, closed: commentsDisabled || commentsClosed}}" /></view></view></block>
            <button wx:if="{{item.motionShowExpand}}" class="thread-toggle" data-id="{{item._id}}" bindtap="toggleThread"><view class="thread-line"></view><text>展开 {{item.remainingCount}} 条回复</text><image src="/images/interface/chevron-down.svg" /></button>
            <block wx:if="{{item.threadOpen}}">
              <button wx:if="{{item.threadEarlier}}" class="thread-toggle" data-id="{{item._id}}" bindtap="earlierChildren" disabled="{{item.threadLoading}}"><view class="thread-line"></view><text>查看更早的回复</text></button>
              <view wx:for="{{item.motionVisibleChildren}}" wx:for-item="child" wx:key="_id" class="comment-nested-grid {{child.motionAncestorFolded ? 'is-hidden' : ''}} {{child.motionAncestorClass}}" aria-hidden="{{child.motionAncestorFolded}}"><view class="comment-nested-clip"><template is="comment" data="{{row: child, child: true, closed: commentsDisabled || commentsClosed}}" /></view></view>
              <view wx:if="{{item.threadLoading}}" class="thread-status">正在读取回复…</view>
              <view wx:elif="{{item.threadError}}" class="thread-error">{{item.threadError}}<button data-id="{{item._id}}" bindtap="retryChildren">重试</button></view>
              <button wx:elif="{{item.threadHasMore}}" class="thread-toggle" data-id="{{item._id}}" bindtap="moreChildren"><view class="thread-line"></view><text>展开更多回复</text><image src="/images/interface/chevron-down.svg" /></button>
            </block>
            <button wx:if="{{item.motionShowCollapse}}" class="thread-toggle" data-id="{{item._id}}" bindtap="collapseThread"><view class="thread-line"></view><text>收起</text><image class="chevron-up" src="/images/interface/chevron-down.svg" /></button>
          </view></view></view>
        </view>
        <view wx:if="{{loadingMore}}" class="comments-status">正在加载…</view>
        <button wx:elif="{{hasMore}}" class="comments-more" bindtap="loadMore">查看更多评论</button>
      </scroll-view>
    </view>
    <view wx:if="{{commentsDisabled || commentsClosed}}" class="comments-footer comments-closed">该账号已关闭评论</view>
    <view wx:else class="comments-footer">
      <view wx:if="{{sendError}}" class="comments-send-error">{{sendError}}</view>
      <view wx:if="{{replyTarget}}" class="comment-target"><text>回复 {{replyTarget.nickname}}</text><button bindtap="cancelReply" disabled="{{sending}}" aria-label="取消回复，改为评论动态"><image src="/images/interface/x.svg" /></button></view>
      <view wx:if="{{selectedImages.length}}" class="comment-selected-images">
        <view class="comment-image-grid">
          <view wx:for="{{selectedImages}}" wx:key="key" class="comment-image-cell" data-selected="{{true}}" data-index="{{index}}" catchtap="previewCommentImages">
            <image class="comment-image-preview" src="{{item.path || item.fileID}}" mode="aspectFill" />
            <view wx:if="{{choosingImages && !item.fileID}}" class="comment-image-uploading">上传中…</view>
            <button class="comment-image-remove" data-index="{{index}}" catchtap="removeCommentImage" disabled="{{sending || choosingImages}}" aria-label="移除第{{index + 1}}张图片"><image src="/images/interface/x.svg" /></button>
          </view>
        </view>
      </view>
      <view class="comment-composer {{count || selectedImages.length || sending ? 'has-content' : ''}} {{count || sending ? 'has-text' : ''}}" style="padding-bottom: {{keyboardHeight ? '20rpx' : 'calc(20rpx + env(safe-area-inset-bottom))'}};">
        <block wx:if="{{viewer}}">
          <view class="comment-input-pill">
            <image wx:if="{{!inputFocused && !count && !selectedImages.length && !sending}}" class="composer-avatar avatar-outline" src="{{viewer.avatarFileID || '/images/avatar.png'}}" mode="aspectFill" aria-hidden="true" />
            <view class="comment-entry"><view class="comment-input-content"><textarea class="comment-textarea" fixed hold-keyboard disable-default-padding="{{true}}" auto-height bindlinechange="traceInputLines" show-confirm-bar="{{false}}" value="{{nativeInputValue}}" cursor="{{inputCursor}}" focus="{{inputFocusRequested}}" bindfocus="focusInput" bindblur="blurInput" bindinput="input" bindkeyboardheightchange="keyboard" maxlength="-1" disabled="{{sending}}" placeholder="{{askAI ? '' : '添加回复...'}}" placeholder-class="composer-placeholder" aria-label="评论输入框" confirm-type="return" confirm-hold="{{true}}" adjust-position="{{false}}" /><view wx:if="{{askAI}}" class="composer-ai-chip composer-ai-mention" aria-label="已选择小萃，退格可删除">@小萃</view></view></view>
            <view class="composer-tools" aria-hidden="{{count > 0 || sending}}">
              <view class="composer-tool-icons">
              <button wx:if="{{!newsComments}}" class="composer-ai-chip composer-ask-ai" catchtap="askXiaocui" disabled="{{sending}}" aria-label="问问小萃"><template is="xiaocui-icon" /><text>问问小萃</text></button>
              <button class="composer-tool composer-image-trigger" aria-label="从相册或拍照添加图片，最多3张" catchtap="chooseCommentImages" disabled="{{count > 0 || sending || choosingImages}}"><image src="/images/interface/comment-image.svg" mode="aspectFit" /></button>
              <view class="composer-tool" aria-label="贴纸，暂未开放" catchtap="stopEvent"><image src="/images/interface/comment-sticker.svg" mode="aspectFit" /></view>
              <view class="composer-tool" aria-label="GIF，暂未开放" catchtap="stopEvent"><image src="/images/interface/comment-gif.svg" mode="aspectFit" /></view>
              </view>
            </view>
            <view class="comment-counter-slot {{count ? 'is-visible' : ''}}" aria-hidden="{{!count}}"><view class="comment-counter-divider"></view><view class="comment-progress-anchor"><view wx:if="{{limitHintVisible}}" class="comment-limit-hint" aria-role="alert">已达到输入上限</view><view class="comment-progress {{countWarning ? 'is-warning' : ''}}" style="background-image: conic-gradient({{countWarning ? '#e44646' : '#4775fa'}} 0deg, {{countWarning ? '#e44646' : '#4775fa'}} {{countProgress}}deg, #dce0e5 {{countProgress}}deg, #dce0e5 360deg);" aria-role="progressbar" aria-label="{{'剩余可输入' + remainingCount + '字，上限50字'}}"><view><text>{{countWarning ? remainingCount : ''}}</text></view></view></view></view>
          </view>
          <view class="composer-send-slot" aria-hidden="{{!count && !selectedImages.length && !sending}}"><button class="comment-send" bindtap="send" loading="{{sending}}" disabled="{{sending || choosingImages || !canSend}}" aria-label="{{sending ? '正在发送评论' : '发送评论'}}"><image wx:if="{{!sending}}" src="/images/interface/arrow-up-white.svg" mode="aspectFit" /></button></view>
        </block>
        <button wx:else class="comment-login" bindtap="login">登录后发表评论</button>
      </view>
    </view>
  </view>
</view>
