<template name="comment">
  <view id="comment-{{row._id}}" class="comment-row {{child ? 'is-child' : ''}}" data-id="{{row._id}}" bindtap="selectReply">
    <image class="comment-avatar" src="{{row.author.avatarFileID || '/images/avatar.png'}}" mode="aspectFill" />
    <view class="comment-main">
      <view class="comment-heading"><text>{{row.author.nickname}}</text><image wx:if="{{row.author.verified}}" class="comment-badge" src="/images/verification/verified.png" /><text wx:if="{{row.addressed}}" class="comment-address">回复 {{row.replyToName}}</text></view>
      <view wx:if="{{row.folded}}" class="comment-folded"><image src="/images/interface/alert-circle-muted.svg" /><text>该评论已折叠</text></view>
      <text wx:else class="comment-text">{{row.content}}</text>
      <view class="comment-meta">
        <text class="comment-time">{{row.timeText}}</text><text wx:if="{{!row.folded}}" class="comment-reply-label">回复</text>
        <view class="comment-actions">
          <button class="comment-action {{row.liked ? 'is-liked' : ''}}" data-id="{{row._id}}" data-kind="like" catchtap="reactComment" aria-label="{{row.liked ? '取消点赞' : '点赞评论'}}"><image src="/images/interface/heart{{row.liked ? '-active' : '-muted'}}.svg" /><text>{{row.likeCount || 0}}</text></button>
          <button class="comment-action comment-dislike" data-id="{{row._id}}" data-kind="fold" catchtap="reactComment" aria-label="{{row.folded ? '恢复此评论及回复' : '仅为我折叠此评论及回复'}}"><image src="/images/interface/heart-broken{{row.folded ? '-active' : '-muted'}}.svg" /></button>
        </view>
      </view>
    </view>
  </view>
</template>
<view class="comments-layer" catchtouchmove="stopEvent">
  <view class="comments-mask" bindtap="close"></view>
  <view class="comments-panel {{dragging ? 'is-dragging' : ''}}" style="top: {{keyboardHeight ? keyboardTop : sheetTop}}px; height: {{viewportHeight - (keyboardHeight ? keyboardTop : sheetTop) - keyboardHeight}}px;" aria-role="dialog" aria-label="动态评论">
    <view class="comments-grabber" catchtouchstart="dragStart" catchtouchmove="dragMove" catchtouchend="dragEnd" catchtouchcancel="dragCancel" aria-label="上下拖动可切换评论区高度"><view class="comments-grabber-bar"></view></view>
    <view class="comments-header"><text>评论</text><button class="comments-close" bindtap="close" disabled="{{sending}}" aria-label="关闭评论"><image src="/images/interface/x.svg" mode="aspectFit" /></button></view>
    <view class="comments-body">
      <scroll-view class="comments-list" scroll-y scroll-into-view="{{scrollIntoView}}" scroll-with-animation bindscrolltolower="loadMore" lower-threshold="100">
        <view wx:if="{{error}}" class="comments-error">{{error}}<button bindtap="retry">重试</button></view>
        <view wx:if="{{loading}}" class="comments-status">正在读取评论…</view>
        <view wx:elif="{{!items.length && !error}}" class="comments-status">还没有评论，说说你的想法吧</view>
        <view wx:for="{{items}}" wx:key="_id" class="comment-group">
          <template is="comment" data="{{row: item, child: false}}" />
          <view wx:if="{{!item.folded}}" class="comment-thread">
            <button wx:if="{{item.showExpand}}" class="thread-toggle" data-id="{{item._id}}" bindtap="toggleThread"><view class="thread-line"></view><text>展开 {{item.remainingCount}} 条回复</text><image src="/images/interface/chevron-down.svg" /></button>
            <block wx:if="{{item.threadOpen}}">
              <template wx:for="{{item.children}}" wx:for-item="child" wx:key="_id" is="comment" data="{{row: child, child: true}}" />
              <view wx:if="{{item.threadLoading}}" class="thread-status">正在读取回复…</view>
              <view wx:elif="{{item.threadError}}" class="thread-error">{{item.threadError}}<button data-id="{{item._id}}" bindtap="retryChildren">重试</button></view>
              <button wx:elif="{{item.threadHasMore}}" class="thread-toggle" data-id="{{item._id}}" bindtap="moreChildren"><view class="thread-line"></view><text>展开更多回复</text><image src="/images/interface/chevron-down.svg" /></button>
            </block>
            <template wx:for="{{item.freshChildren}}" wx:for-item="fresh" wx:key="_id" is="comment" data="{{row: fresh, child: true}}" />
            <button wx:if="{{item.showCollapse}}" class="thread-toggle" data-id="{{item._id}}" bindtap="collapseThread"><view class="thread-line"></view><text>收起</text><image class="chevron-up" src="/images/interface/chevron-down.svg" /></button>
          </view>
        </view>
        <view wx:if="{{loadingMore}}" class="comments-status">正在加载…</view>
        <button wx:elif="{{hasMore}}" class="comments-more" bindtap="loadMore">查看更多评论</button>
      </scroll-view>
    </view>
    <view class="comments-footer">
      <view wx:if="{{sendError}}" class="comments-send-error">{{sendError}}</view>
      <view wx:if="{{replyTarget}}" class="comment-target"><text>回复 {{replyTarget.nickname}}</text><button bindtap="cancelReply" disabled="{{sending}}" aria-label="取消回复，改为评论动态"><image src="/images/interface/x.svg" /></button></view>
      <view class="comment-composer" style="padding-bottom: {{keyboardHeight ? '20rpx' : 'calc(20rpx + env(safe-area-inset-bottom))'}};">
        <block wx:if="{{viewer}}"><input value="{{text}}" focus="{{inputFocused}}" bindblur="blurInput" bindinput="input" bindkeyboardheightchange="keyboard" maxlength="600" disabled="{{sending}}" placeholder="{{replyTarget ? '回复 ' + replyTarget.nickname : '写下你的评论'}}" confirm-type="send" bindconfirm="send" adjust-position="{{false}}" /><button class="comment-send" bindtap="send" loading="{{sending}}" disabled="{{sending || !canSend}}">发送</button></block>
        <button wx:else class="comment-login" bindtap="login">登录后发表评论</button>
      </view>
    </view>
  </view>
</view>
