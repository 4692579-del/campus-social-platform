:host { display: block; width: 100%; min-width: 0; }
.search-field { display: flex; align-items: center; flex-wrap: nowrap; gap: 12rpx; width: 100%; height: 80rpx; padding: 0 18rpx; border-radius: 24rpx; box-sizing: border-box; background: #f1f3f5; }
.search-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.search-author-chip { display: flex; align-items: center; flex-shrink: 0; height: 52rpx; max-width: 230rpx; padding: 0 2rpx 0 16rpx; border-radius: 999rpx; background: #e0e3e8; color: #4b5058; font-size: 24rpx; line-height: 32rpx; font-weight: 600; font-variant-numeric: tabular-nums; box-sizing: border-box; }
.search-author-id { white-space: nowrap; }
.chip-remove { display: flex; align-items: center; justify-content: center; flex: 0 0 44rpx; width: 44rpx; height: 48rpx; min-width: 0; margin: 0; padding: 0; border: 0; background: transparent; line-height: 1; }
.chip-remove-icon { display: block; width: 22rpx; height: 22rpx; opacity: .58; }
.search-input { flex: 1 1 0%; width: 0; min-width: 30rpx; height: 40rpx; line-height: 40rpx; padding: 0; color: #171b20; font-size: 28rpx; }
.search-placeholder { color: #8b949e; font-size: 28rpx; }
