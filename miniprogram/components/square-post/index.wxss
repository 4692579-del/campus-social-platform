@import "../../styles/avatar.wxss";
@import "../../styles/post-play-badge.wxss";
:host { display: block; }
.post-pin { display: flex; align-items: center; gap: 8rpx; padding: 22rpx 16rpx 0 106rpx; color: #87919c; background: #fff; font-size: 23rpx; font-weight: 500; line-height: 30rpx; }
.post-pin image { display: block; width: 24rpx; height: 24rpx; flex-shrink: 0; }
.post-card.is-pinned { padding-top: 10rpx; }
.post-card { display: flex; gap: 14rpx; padding: 28rpx 16rpx 24rpx; background: #fff; border-bottom: 1rpx solid #dce1e7; color: #171b20; }
.post-avatar { display: block; width: 76rpx; height: 76rpx; flex-shrink: 0; border-radius: 50%; background: #f0f2f4; }
.post-avatar-anchor { position: relative; flex: 0 0 76rpx; width: 76rpx; height: 76rpx; }
.post-avatar-follow { position: absolute; right: -7rpx; bottom: -7rpx; display: flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; box-sizing: border-box; border: 4rpx solid #fff; border-radius: 50%; background: #4775FA; pointer-events: none; }
.post-avatar-follow image { display: block; width: 21rpx; height: 21rpx; }
.post-avatar-follow .follow-check { position: absolute; opacity: 0; transform: scale(.4) rotate(-20deg); }
.post-avatar-follow.is-demo-followed { opacity: 0; transform: translate(5rpx, 6rpx) scale(.18); }
.post-avatar-follow.is-demo-following { animation: follow-circle-confirm 1200ms ease both; }
.is-demo-following .follow-plus { animation: follow-plus-away 1200ms ease both; }
.post-avatar-follow.is-demo-following .follow-check { animation: follow-check-arrive 1200ms ease both; }
@keyframes follow-circle-confirm { 0% { opacity: 1; transform: scale(1); } 14% { transform: scale(.88); } 30% { transform: scale(1.12); } 42%, 70% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: translate(5rpx, 6rpx) scale(.18); } }
@keyframes follow-plus-away { 0%, 8% { opacity: 1; transform: scale(1) rotate(0); } 26%, 100% { opacity: 0; transform: scale(.25) rotate(90deg); } }
@keyframes follow-check-arrive { 0%, 14% { opacity: 0; transform: scale(.4) rotate(-20deg); } 32% { opacity: 1; transform: scale(1.12) rotate(0); } 44%, 100% { opacity: 1; transform: scale(1) rotate(0); } }
@media (prefers-reduced-motion: reduce) { .post-avatar-follow.is-demo-following { animation: none; opacity: 0; } .is-demo-following .follow-plus, .post-avatar-follow.is-demo-following .follow-check { animation: none; } }
.post-main { flex: 1; min-width: 0; }
.post-heading { display: flex; align-items: center; gap: 8rpx; min-height: 40rpx; height: 40rpx; }
.post-name { max-width: 330rpx; min-width: 0; flex: 0 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 29rpx; font-weight: 700; }
.author-badge { display: block; width: 24rpx; height: 24rpx; flex-shrink: 0; }
.post-time { flex-shrink: 0; font-size: 23rpx; color: #87919c; white-space: nowrap; }
.post-header-actions { display: flex; align-items: center; gap: 16rpx; flex-shrink: 0; height: 40rpx; margin-left: auto; }
.post-header-actions .post-more { display: flex; align-items: center; justify-content: center; flex: 0 0 48rpx; width: 48rpx; min-width: 0; height: 52rpx; margin: 0; padding: 0; background: transparent; border: 0; border-radius: 0; line-height: 1; }
.post-more::after { border: 0; }
.post-more image { display: block; width: 36rpx; height: 36rpx; }
.post-handle { flex-shrink: 0; color: #87919c; font-size: 23rpx; line-height: 1.6; white-space: nowrap; }
.post-text { display: block; margin-top: 6rpx; font-size: 29rpx; line-height: 1.55; white-space: pre-wrap; word-break: break-word; }
.post-text-seven-lines { line-height: 45rpx; }
.post-text-clip { max-height: 321rpx; overflow: hidden; }
.expand-post { margin-top: 8rpx; color: #4775fa; font-size: 27rpx; line-height: 1.6; }
.post-image-gallery { position: relative; margin-top: 16rpx; overflow: hidden; }
.post-photo-frame { position: relative; width: 100%; height: 100%; overflow: hidden; border-radius: 20rpx; background: #f0f2f4; }
.post-photo-frame::after { content: ''; position: absolute; z-index: 1; inset: 0; border: 1rpx solid #dce1e7; border-radius: inherit; box-sizing: border-box; pointer-events: none; }
.post-image-swiper { width: 100%; height: 100%; }
.post-image-slide { box-sizing: border-box; padding-right: 12rpx; }
.post-photo { display: block; width: 100%; height: 100%; }
.post-video-frame { position: relative; }
.post-inline-video { position: absolute; inset: 0; display: block; width: 100%; height: 100%; opacity: 0; pointer-events: none; }
.post-inline-video.is-ready { opacity: 1; }
.post-video-cover, .post-video-loading { position: absolute; inset: 0; pointer-events: none; }
.post-video-cover { background: #f0f2f4; }
.post-video-cover.is-hidden { visibility: hidden; }
.post-video-loading { display: flex; align-items: center; justify-content: center; }
.post-video-loading-icon { display: block; width: 40rpx; height: 40rpx; animation: post-video-spin .8s steps(8, end) infinite; }
@keyframes post-video-spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .post-video-loading-icon { animation: none; } }
.post-image-counter { position: absolute; bottom: 14rpx; right: 70rpx; padding: 5rpx 12rpx; border-radius: 24rpx; background: rgba(15, 23, 37, .42); color: #fff; font-size: 21rpx; line-height: 1.3; pointer-events: none; }
.post-declaration { display: flex; align-items: flex-start; gap: 8rpx; margin-top: 14rpx; color: #87919c; font-size: 23rpx; line-height: 1.5; }
.post-declaration image { flex-shrink: 0; width: 25rpx; height: 25rpx; margin-top: 5rpx; }
.post-declaration text { min-width: 0; word-break: break-word; }
.post-actions { display: flex; align-items: center; gap: 40rpx; margin-top: 14rpx; }
.post-quote { display: block; margin-top: 18rpx; }
.post-actions .post-action { display: flex; align-items: center; justify-content: flex-start; flex: 0 0 auto; width: auto; min-width: 100rpx; gap: 10rpx; height: 64rpx; padding: 0; margin: 0; box-sizing: border-box; background: transparent; border: 0; border-radius: 0; color: #454745; font-size: 28rpx; font-weight: 400; line-height: 1; }
.post-action::after { border: 0; }
.post-action image { display: block; width: 40rpx; height: 40rpx; flex-shrink: 0; }
.post-action text { font-variant-numeric: tabular-nums; white-space: nowrap; }
.post-actions .post-action-share { min-width: 40rpx; }
.post-actions .liked { color: #e34b76; }

.post-date { position: relative; margin-top: 16rpx; padding: 12rpx 0; color: #8b949e; font-size: 23rpx; line-height: 1.6; }
/* 跨过头像列及两侧内边距，让时间下方的分隔线完整铺满卡片。 */
.post-date::after { content: ''; position: absolute; left: -106rpx; right: -16rpx; bottom: 0; border-bottom: 1rpx solid #dce1e7; pointer-events: none; }

/* 详情头部保留头像列，正文及其后的图片、声明、时间和互动统一铺满内容宽度。 */
.post-card.is-detail { position: relative; display: block; }
.is-detail .post-avatar { position: absolute; top: 28rpx; left: 16rpx; }
.is-detail .post-author-details { min-height: 76rpx; margin-left: 90rpx; }
.is-detail .post-handle { display: block; }
.is-detail .post-text { margin-top: 24rpx; }
.is-detail .post-date::after { left: -16rpx; }

/* 仅图标局部合成动画，固定占位使数字、图片和整张卡片不随弹跳移动。 */
.post-actions .post-action-like { overflow: visible; }
.like-stage { position: relative; display: block; width: 40rpx; height: 40rpx; flex-shrink: 0; overflow: visible; }
.like-stage .like-glyph { position: relative; z-index: 2; width: 40rpx; height: 40rpx; transform-origin: center; }
.like-burst { position: absolute; inset: 0; pointer-events: none; }
.like-burst-ring { position: absolute; inset: 0; box-sizing: border-box; border: 0 solid #c66de0; border-radius: 50%; opacity: 0; }
.like-particle-ray { position: absolute; inset: 0; transform-origin: center; }
.like-particle { position: absolute; left: 50%; top: 50%; width: 5rpx; height: 5rpx; border-radius: 50%; opacity: 0; }
.like-particle-pair { width: 4rpx; height: 4rpx; }
.is-like-a .like-glyph, .is-like-b .like-glyph { animation: post-heart-pop-a 900ms linear both; }
.is-like-a .like-burst-ring, .is-like-b .like-burst-ring { animation: post-heart-ring-a 900ms linear both; }
.is-like-a .like-particle-main, .is-like-b .like-particle-main { animation: post-heart-particle-a 900ms cubic-bezier(.16,.7,.3,1) both; }
.is-like-a .like-particle-pair, .is-like-b .like-particle-pair { animation: post-heart-pair-a 900ms cubic-bezier(.16,.7,.3,1) both; }
.is-unlike-a .like-glyph, .is-unlike-b .like-glyph { animation: post-heart-unlike-a 400ms cubic-bezier(.22,.75,.3,1) both; }
.is-like-b .like-glyph { animation-name: post-heart-pop-b; }
.is-like-b .like-burst-ring { animation-name: post-heart-ring-b; }
.is-like-b .like-particle-main { animation-name: post-heart-particle-b; }
.is-like-b .like-particle-pair { animation-name: post-heart-pair-b; }
.is-unlike-b .like-glyph { animation-name: post-heart-unlike-b; }
@keyframes post-heart-pop-a { 0%, 15% { transform: scale(0); } 26% { transform: scale(.28); } 40% { transform: scale(1.18); } 54% { transform: scale(.92); } 68%, 100% { transform: scale(1); } }
@keyframes post-heart-pop-b { 0%, 15% { transform: scale(0); } 26% { transform: scale(.28); } 40% { transform: scale(1.18); } 54% { transform: scale(.92); } 68%, 100% { transform: scale(1); } }
@keyframes post-heart-ring-a { 0% { opacity: 1; transform: scale(0); border-width: 20rpx; border-color: #e34b76; } 16% { opacity: 1; transform: scale(1.35); border-width: 20rpx; border-color: #c66de0; } 25% { opacity: 1; transform: scale(1.7); border-width: 17rpx; } 36% { opacity: .9; transform: scale(1.95); border-width: 2rpx; } 45%, 100% { opacity: 0; transform: scale(2.1); border-width: 0; } }
@keyframes post-heart-ring-b { 0% { opacity: 1; transform: scale(0); border-width: 20rpx; border-color: #e34b76; } 16% { opacity: 1; transform: scale(1.35); border-width: 20rpx; border-color: #c66de0; } 25% { opacity: 1; transform: scale(1.7); border-width: 17rpx; } 36% { opacity: .9; transform: scale(1.95); border-width: 2rpx; } 45%, 100% { opacity: 0; transform: scale(2.1); border-width: 0; } }
@keyframes post-heart-particle-a { 0%, 15% { opacity: 0; transform: translate(-50%, -50%) translateY(-22rpx) scale(.9); } 28% { opacity: 1; transform: translate(-50%, -50%) translateY(-32rpx) scale(1); } 48% { opacity: .9; transform: translate(-50%, -50%) translateY(-43rpx) scale(.9); } 85%, 100% { opacity: 0; transform: translate(-50%, -50%) translateY(-50rpx) scale(.4); } }
@keyframes post-heart-particle-b { 0%, 15% { opacity: 0; transform: translate(-50%, -50%) translateY(-22rpx) scale(.9); } 28% { opacity: 1; transform: translate(-50%, -50%) translateY(-32rpx) scale(1); } 48% { opacity: .9; transform: translate(-50%, -50%) translateY(-43rpx) scale(.9); } 85%, 100% { opacity: 0; transform: translate(-50%, -50%) translateY(-50rpx) scale(.4); } }
@keyframes post-heart-pair-a { 0%, 15% { opacity: 0; transform: translate(-50%, -50%) translate(6rpx, -20rpx) scale(.9); } 28% { opacity: 1; transform: translate(-50%, -50%) translate(8rpx, -29rpx) scale(1); } 48% { opacity: .85; transform: translate(-50%, -50%) translate(9rpx, -37rpx) scale(.85); } 85%, 100% { opacity: 0; transform: translate(-50%, -50%) translate(10rpx, -45rpx) scale(.4); } }
@keyframes post-heart-pair-b { 0%, 15% { opacity: 0; transform: translate(-50%, -50%) translate(6rpx, -20rpx) scale(.9); } 28% { opacity: 1; transform: translate(-50%, -50%) translate(8rpx, -29rpx) scale(1); } 48% { opacity: .85; transform: translate(-50%, -50%) translate(9rpx, -37rpx) scale(.85); } 85%, 100% { opacity: 0; transform: translate(-50%, -50%) translate(10rpx, -45rpx) scale(.4); } }
@keyframes post-heart-unlike-a { 0% { transform: scale(1); } 25% { transform: scale(1.55); } 72% { transform: scale(.88); } 100% { transform: scale(1); } }
@keyframes post-heart-unlike-b { 0% { transform: scale(1); } 25% { transform: scale(1.55); } 72% { transform: scale(.88); } 100% { transform: scale(1); } }
@media (prefers-reduced-motion: reduce) { .like-stage .like-glyph { animation: none; transform: none; } .like-burst { display: none; } }
