function format(value) {
  if (typeof value !== 'number' || !(value > 0) || value - value !== 0) return '0';
  var count = Math.floor(value);
  if (count >= 100000000) return (Math.floor(count / 10000000) / 10) + '亿';
  if (count >= 10000) return (Math.floor(count / 1000) / 10) + '万';
  return '' + count;
}
function formatKnown(value) {
  return value === '—' ? value : format(value);
}
module.exports = { format: format, formatKnown: formatKnown };
