<template name="actions">
  <view class="post-actions">
    <button class="post-action {{post.liked ? 'liked' : ''}}" bindtap="like" aria-label="{{post.liked ? '取消点赞' : '点赞'}}"><image src="/images/interface/heart{{post.liked ? '-active' : '-muted'}}.svg" mode="aspectFit" /><text>{{post.likeCount || 0}}</text></button>
    <button class="post-action" bindtap="reply" aria-label="查看评论"><image src="/images/interface/message-square-muted.svg" mode="aspectFit" /><text>{{post.replyCount || 0}}</text></button>
    <button class="post-action {{post.reposted ? 'reposted' : ''}}" bindtap="repost" aria-label="{{post.reposted ? '取消转发' : '转发'}}"><image src="/images/interface/repeat{{post.reposted ? '-active' : '-muted'}}.svg" mode="aspectFit" /><text>{{post.repostCount || 0}}</text></button>
    <button class="post-action share-action" open-type="{{viewer ? 'share' : ''}}" bindtap="share" data-id="{{post._id}}" aria-label="分享，发起分享{{post.shareCount || 0}}次"><image src="/images/interface/send-muted.svg" mode="aspectFit" /><text>{{post.shareCount || 0}}</text></button>
  </view>
</template>
<view class="post-card">
  <image class="post-avatar" src="{{post.author.avatarFileID || '/images/avatar.png'}}" mode="aspectFill" />
  <view class="post-main">
    <view class="post-heading"><text class="post-name">{{post.author.nickname}}</text><image wx:if="{{post.author.verified}}" class="author-badge" src="/images/verification/verified.png" /><text class="post-time">· {{post.timeText}}</text><view class="post-header-actions"><button class="post-follow" disabled aria-label="关注功能暂未开放">关注</button><button class="post-more" catchtap="more" aria-label="动态更多操作"><image src="/images/interface/menu-two.svg" mode="aspectFit" /></button></view></view>
    <view wx:if="{{post.author.accountId}}" class="post-handle">@{{post.author.accountId}}</view>
    <text class="post-text" selectable>{{expanded ? (post.fullContent || post.content) : post.content}}</text>
    <view wx:if="{{post.truncated}}" class="expand-post" bindtap="toggleExpanded">{{expanded ? '收起' : '展开全文'}}</view>
    <template is="actions" data="{{post: post, viewer: viewer}}" />
  </view>
</view>
