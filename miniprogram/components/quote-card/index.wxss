@import "../../styles/avatar.wxss";
:host { display: block; min-width: 0; }
.quote-frame { position: relative; padding: 24rpx; color: #171b20; }
.quote-border { position: absolute; top: 0; right: 0; bottom: 0; left: 0; box-sizing: border-box; border: 2rpx dashed #c7cdd6; border-radius: 22rpx; pointer-events: none; }
/* 用两个边框段真实留空，避免小程序不支持clip-path时出现贯穿X的顶边。 */
.is-removable .quote-border { right: 28rpx; border-right: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; }
.quote-border-corner { position: absolute; top: 28rpx; right: 0; bottom: 0; width: 28rpx; box-sizing: border-box; border-right: 2rpx dashed #c7cdd6; border-bottom: 2rpx dashed #c7cdd6; border-bottom-right-radius: 22rpx; pointer-events: none; }
.quote-heading { display: flex; align-items: center; gap: 10rpx; min-height: 42rpx; }
.is-removable .quote-heading { padding-right: 20rpx; }
.quote-avatar { flex-shrink: 0; width: 40rpx; height: 40rpx; border-radius: 50%; background: #f0f2f4; }
.quote-name { min-width: 0; font-size: 25rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.quote-verified { width: 21rpx; height: 21rpx; flex-shrink: 0; }
.quote-time { margin-left: auto; flex-shrink: 0; color: #939ba7; font-size: 21rpx; }
.quote-content { display: block; margin-top: 12rpx; white-space: pre-wrap; word-break: break-word; font-size: 27rpx; line-height: 1.65; }
.quote-media-width { width: 100%; margin-top: 16rpx; }
.quote-gallery { position: relative; overflow: hidden; border-radius: 20rpx; }
.quote-swiper, .quote-photo, .quote-photo-frame { display: block; width: 100%; height: 100%; }
.quote-photo-frame { box-sizing: border-box; padding-right: 12rpx; }
.quote-slide-photo { display: block; width: 100%; height: 100%; border-radius: 20rpx; }
.quote-image-count { position: absolute; right: 10rpx; bottom: 10rpx; padding: 4rpx 12rpx; border-radius: 20rpx; color: white; background: rgba(20,25,32,.5); font-size: 20rpx; }
.quote-declaration { display: flex; align-items: center; gap: 6rpx; margin-top: 12rpx; color: #939ba7; font-size: 21rpx; }
.quote-declaration-icon { width: 23rpx; height: 23rpx; }
.quote-remove { position: absolute; z-index: 2; top: 0; left: 100%; right: auto; bottom: auto; transform: translate(-50%, -50%); display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 48rpx; height: 48rpx; padding: 0; margin: 0; background: transparent; line-height: 1; }
.quote-remove-icon { display: block; flex-shrink: 0; width: 29rpx; height: 29rpx; }
.quote-remove.is-disabled { opacity: .4; }
.quote-placeholder { padding: 12rpx 4rpx; color: #939ba7; font-size: 25rpx; line-height: 1.6; }
.quote-entry.is-nested { margin: 18rpx 0 0 12rpx; padding: 18rpx; border: 2rpx dashed #d6dbe2; border-radius: 16rpx; }
