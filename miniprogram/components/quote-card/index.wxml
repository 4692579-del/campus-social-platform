<view class="quote-frame {{removable ? 'is-removable' : ''}}" data-id="{{frames[0]._id}}" catchtap="open">
  <view class="quote-border" aria-hidden="true"></view>
  <view wx:for="{{frames}}" wx:key="_id" class="quote-entry {{index ? 'is-nested' : ''}}" data-id="{{item._id}}" catchtap="open" aria-role="{{removable ? 'region' : 'button'}}" aria-label="{{item.unavailable ? '原动态不可见' : '引用的动态'}}">
    <view wx:if="{{item.loading || item.unavailable || item.failed || item.collapsed}}" class="quote-placeholder">{{item.loading ? '正在读取原动态…' : item.unavailable ? '原动态已删除或不可见' : item.failed ? '原动态暂时无法读取' : '查看更早的引用 ›'}}</view>
    <block wx:else>
      <view class="quote-heading"><image class="quote-avatar" src="{{item.author.avatarFileID || '/images/avatar.png'}}" mode="aspectFill" /><text class="quote-name">{{item.author.nickname}}</text><image wx:if="{{item.author.verified}}" class="quote-verified" src="/images/verification/verified.png" /><text class="quote-time">{{item.timeText}}</text></view>
      <text wx:if="{{item.content}}" class="quote-content" user-select>{{item.content}}</text>
      <view wx:if="{{item.images.length}}" class="quote-gallery" style="height: {{item.galleryHeight}}rpx;">
        <swiper wx:if="{{item.images.length > 1}}" current="{{item.imageIndex}}" duration="240" next-margin="28rpx" data-frame="{{index}}" bindchange="imageChanged" class="quote-swiper" indicator-dots="{{false}}">
          <swiper-item wx:for="{{item.images}}" wx:for-item="file" wx:for-index="photoIndex" wx:key="*this"><view class="quote-photo-frame"><image class="quote-slide-photo" src="{{file}}" data-frame="{{index}}" data-file="{{file}}" bindload="photoLoaded" mode="aspectFill" lazy-load /></view></swiper-item>
        </swiper>
        <image wx:else class="quote-photo" src="{{item.images[0]}}" data-frame="{{index}}" data-file="{{item.images[0]}}" bindload="photoLoaded" mode="aspectFit" lazy-load />
        <text wx:if="{{item.images.length > 1}}" class="quote-image-count">{{item.imageIndex + 1}} / {{item.images.length}}</text>
      </view>
      <view wx:if="{{item.declarationText}}" class="quote-declaration"><image class="quote-declaration-icon" src="/images/interface/alert-circle-muted.svg" /><text>{{item.declarationText}}</text></view>
    </block>
  </view>
  <button wx:if="{{removable}}" class="quote-remove" catchtap="remove" disabled="{{disabled}}" aria-label="移除整个引用"><image class="quote-remove-icon" src="/images/interface/x.svg" mode="aspectFit" /></button>
</view>
