@import "../comments-sheet/index.wxss";
.reply-history { color: #171b20; background: #fff; }
.history-entry { position: relative; padding: 26rpx 28rpx 18rpx; border-bottom: 1rpx solid #edf0f3; }
.history-context { position: relative; display: flex; gap: 18rpx; padding-bottom: 24rpx; }
.history-context::after { content: ''; position: absolute; top: 52rpx; bottom: -4rpx; left: 31rpx; width: 2rpx; border-radius: 2rpx; background: #dfe3e9; }
.history-context-avatar { flex: 0 0 64rpx; width: 64rpx; height: 64rpx; border-radius: 50%; background: #f0f2f4; }
.history-context-main { flex: 1; min-width: 0; }
.history-context-heading { display: flex; align-items: center; gap: 8rpx; min-height: 36rpx; font-size: 25rpx; color: #8d949d; }
.history-context-heading > text:first-child { max-width: 230rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.history-context-time { flex-shrink: 0; font-size: 22rpx; color: #a1a7af; }
.history-context-link { margin-left: auto; flex-shrink: 0; color: #818a97; font-size: 22rpx; }
.history-context-text { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 4rpx; font-size: 26rpx; line-height: 1.55; color: #747d89; white-space: pre-wrap; word-break: break-word; }
.history-image-count { font-size: 23rpx; color: #8d949d; }
.history-message { padding: 30rpx 28rpx; color: #98a1ad; font-size: 25rpx; text-align: center; }
.history-link { width: auto; min-width: 0; margin: 8rpx auto; padding: 8rpx 20rpx; background: transparent; color: #4775fa; font-size: 25rpx; line-height: 1.6; }
.history-link::after { border: none; }
.history-empty { padding: 80rpx 50rpx; text-align: center; font-size: 30rpx; font-weight: 600; }
.history-empty > text { display: block; margin-top: 14rpx; color: #98a1ad; font-size: 25rpx; font-weight: 400; }
.history-own-reply { position: relative; }
