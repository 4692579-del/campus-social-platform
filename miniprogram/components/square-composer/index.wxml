<import src="../../templates/login-sheet.wxml" />
<view class="composer-layer {{closing ? 'is-closing' : ''}}" catchtouchmove="stopMenuEvent">
  <view class="composer-backdrop" bindtap="cancel"></view>
  <view class="compose-sheet" style="top: {{sheetTop}}px; height: {{viewportHeight - sheetTop - keyboardHeight}}px;" aria-role="dialog" aria-modal="true" aria-label="发布动态">
    <view class="compose-header">
      <button class="compose-cancel" bindtap="cancel" disabled="{{publishing || savingDraft || choosingImages}}">取消</button>
      <text class="compose-title">发布动态</text>
      <view class="compose-capsule">
        <button bindtap="saveAndClose" disabled="{{publishing || savingDraft || choosingImages || (!count && !images.length)}}" aria-label="保存草稿并收起"><image src="/images/interface/file-lines.svg" mode="aspectFit" /></button>
        <view class="capsule-divider"></view>
        <button data-panel="declaration" bindtap="openPanel" disabled="{{publishing || savingDraft || choosingImages}}" aria-label="添加内容声明"><image src="/images/interface/menu-two.svg" mode="aspectFit" /></button>
      </view>
    </view>
    <view class="compose-body">
      <view class="compose-author"><image class="compose-avatar" src="{{user.avatarFileID || '/images/avatar.png'}}" mode="aspectFill" /><view class="compose-destination"><text class="compose-nickname">{{user.nickname || '未登录'}}</text><image src="/images/interface/chevron-right-muted.svg" mode="aspectFit" /><text class="compose-scope">动态广场</text></view></view>
      <view class="compose-editor" bindtap="focusEditor">
        <textarea wx:if="{{!panel && !exitConfirmVisible}}" value="{{content}}" focus="{{editorFocused}}" bindfocus="focusEditor" bindblur="blurEditor" bindinput="onInput" bindkeyboardheightchange="keyboard" placeholder="有什么新鲜事想和大家分享？" placeholder-class="compose-placeholder" maxlength="2000" disabled="{{publishing || savingDraft || !user || loginSheetOpen || closing}}" show-confirm-bar="{{false}}" adjust-position="{{false}}" />
        <text wx:else class="compose-editor-preview {{!content ? 'compose-placeholder' : ''}}">{{content || '有什么新鲜事想和大家分享？'}}</text>
      </view>
      <scroll-view wx:if="{{images.length}}" class="compose-selected-images" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="selected-image-strip"><view wx:for="{{images}}" wx:key="key" class="selected-image"><image src="{{item.fileID || item.path}}" mode="aspectFill" data-index="{{index}}" bindtap="previewSelectedImage" /><button class="remove-image" data-index="{{index}}" bindtap="removeImage" disabled="{{publishing || savingDraft || choosingImages}}" aria-label="移除第{{index + 1}}张图片"><image src="/images/interface/x.svg" /></button></view></view>
      </scroll-view>
    </view>
    <view class="compose-footer">
      <view wx:if="{{error}}" class="compose-error">{{error}}</view>
      <view wx:if="{{(publishing || savingDraft) && uploadTotal}}" class="compose-upload-status">{{uploadDone < uploadTotal ? '正在上传图片 ' + uploadDone + ' / ' + uploadTotal : (savingDraft ? '正在保存图片草稿…' : '正在发布图文…')}}</view>
      <view class="compose-tools" style="padding-bottom: {{keyboardHeight ? '20rpx' : 'calc(20rpx + env(safe-area-inset-bottom))'}};">
        <button class="post-options" data-panel="options" bindtap="openPanel" disabled="{{publishing || savingDraft || choosingImages}}"><image src="/images/interface/sliders.svg" mode="aspectFit" /><text>动态设置</text></button>
        <view class="compose-tools-divider" aria-hidden="true"></view>
        <view class="compose-media"><button class="choose-image-button" bindtap="choosePostImages" disabled="{{publishing || savingDraft || choosingImages}}" aria-label="从相册选择图片或拍照"><image src="/images/interface/comment-image.svg" mode="aspectFit" /></button><view><image src="/images/interface/comment-sticker.svg" mode="aspectFit" /></view><view><image src="/images/interface/comment-gif.svg" mode="aspectFit" /></view></view>
        <view class="compose-submit"><view class="compose-progress" style="background-image: conic-gradient(#171b20 0deg, #171b20 {{countProgress}}deg, #dce0e5 {{countProgress}}deg, #dce0e5 360deg);" aria-role="progressbar" aria-label="{{count > 1000 ? '已超出字数上限' : '已输入' + count + '字，上限1000字'}}"><view></view></view><button class="publish-button" bindtap="publish" loading="{{publishing}}" disabled="{{!canPublish || publishing || savingDraft || choosingImages || !user || loginSheetOpen}}">{{publishing ? (uploadDone < uploadTotal ? '上传中' : '发布中') : '发布'}}</button></view>
      </view>
    </view>
  </view>
  <view wx:if="{{panel}}" class="compose-settings-layer">
    <view class="settings-backdrop" bindtap="closePanel"></view>
    <view class="compose-settings" style="height: {{settingsHeight}}px;" aria-role="dialog" aria-modal="true" aria-label="{{panel === 'options' ? '动态设置' : '添加内容声明'}}">
      <view class="settings-heading"><text>{{panel === 'options' ? '动态设置' : '添加内容声明'}}</text><button bindtap="closePanel" aria-label="关闭选项"><image src="/images/interface/x.svg" /></button></view>
      <scroll-view class="settings-scroll" scroll-y>
        <block wx:if="{{panel === 'options'}}">
          <view class="settings-caption">谁能回复和引用</view>
          <view class="settings-card"><button wx:for="{{audiences}}" wx:key="key" class="settings-row" data-key="{{item.key}}" bindtap="selectAudience" aria-role="radio" aria-checked="{{replyAudience === item.key}}"><text>{{item.label}}</text><view class="settings-radio {{replyAudience === item.key ? 'is-selected' : ''}}"><view></view></view></button></view>
          <view class="settings-caption">谁能查看</view>
          <view class="settings-card"><button wx:for="{{audiences}}" wx:key="key" class="settings-row" data-key="{{item.key}}" bindtap="selectViewAudience" aria-role="radio" aria-checked="{{viewAudience === item.key}}"><text>{{item.label}}</text><view class="settings-radio {{viewAudience === item.key ? 'is-selected' : ''}}"><view></view></view></button></view>
        </block>
        <block wx:else>
          <view class="settings-card declaration-none"><button class="settings-row" data-key="none" bindtap="selectDeclaration" aria-role="radio" aria-checked="{{declaration === 'none'}}"><text>无需声明</text><view class="settings-radio {{declaration === 'none' ? 'is-selected' : ''}}"><view></view></view></button></view>
          <view class="settings-card"><block wx:for="{{declarations}}" wx:key="key"><button wx:if="{{item.key !== 'none'}}" class="settings-row" data-key="{{item.key}}" bindtap="selectDeclaration" aria-role="radio" aria-checked="{{declaration === item.key}}"><text>{{item.label}}</text><view class="settings-radio {{declaration === item.key ? 'is-selected' : ''}}"><view></view></view></button></block></view>
        </block>
      </scroll-view>
      <view class="settings-actions"><button class="settings-done" bindtap="closePanel">完成</button></view>
    </view>
  </view>
  <view wx:if="{{exitConfirmVisible}}" class="compose-exit-layer" catchtouchmove="stopMenuEvent">
    <view class="compose-exit-backdrop" catchtap="stopMenuEvent"></view>
    <view class="compose-exit-dialog" aria-role="dialog" aria-modal="true" aria-label="是否保存当前动态为草稿" catchtap="stopMenuEvent">
      <view wx:if="{{error}}" class="compose-exit-error" aria-role="alert">{{error}}</view>
      <button class="exit-save" bindtap="saveAndClose" loading="{{savingDraft}}" disabled="{{savingDraft}}">{{savingDraft ? '正在保存…' : '保存为草稿'}}</button>
      <button class="exit-discard" bindtap="discardAndClose" disabled="{{savingDraft}}">不保存</button>
      <button class="exit-continue" bindtap="continueEditing" disabled="{{savingDraft}}">继续编辑</button>
    </view>
  </view>
  <template is="login-sheet" data="{{loginSheetOpen, error: loginError, loading: loginLoading, cancelText: '暂不登录'}}" />
</view>
