<form class="edit-page" bindsubmit="save">
  <view class="edit-header" style="padding-top: {{navHeight}}px;">
    <view class="toolbar-title" style="top: {{navTop}}px; height: {{navButtonHeight}}px; line-height: {{navButtonHeight}}px;">编辑个人资料</view>
    <view class="edit-toolbar">
      <button size="mini" class="toolbar-button cancel-button" bindtap="cancel" disabled="{{saving || choosingCover}}">取消</button>
      <button size="mini" class="toolbar-button done-button" form-type="submit" loading="{{saving}}" disabled="{{loading || saving || choosingCover || !user || !dirty}}">{{saving ? '保存中' : '完成'}}</button>
    </view>
  </view>
  <view wx:if="{{loading}}" class="page-notice">正在读取个人资料…</view>
  <block wx:elif="{{user}}">
    <view class="edit-cover" style="height: calc({{navHeight}}px + 260rpx);">
      <image wx:if="{{cover && !coverFailed}}" class="cover-image" src="{{cover}}" mode="aspectFill" binderror="onCoverError" />
      <button size="mini" class="cover-change" bindtap="chooseCover" disabled="{{saving || choosingCover}}" loading="{{choosingCover}}">{{choosingCover ? '选择中' : '更换封面'}}</button>
    </view>
    <view class="avatar-row">
      <button size="mini" class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{saving || choosingCover}}" aria-label="更换头像">
        <image class="edit-avatar avatar-outline" src="{{avatar || '/images/avatar.png'}}" mode="aspectFill" />
        <view class="avatar-overlay"><view class="camera-icon"><view class="camera-lens"></view></view><view class="camera-plus">+</view></view>
      </button>
    </view>
    <view wx:if="{{error}}" class="cs-error edit-error">{{error}}</view>
    <view class="field-row">
      <view class="field-label">昵称</view>
      <input class="field-input" name="nickname" type="nickname" value="{{nickname}}" bindinput="onNicknameChange" bindblur="onNicknameChange" maxlength="40" disabled="{{saving}}" placeholder="填写你的昵称" placeholder-class="placeholder" />
    </view>
    <view class="field-row bio-row">
      <view class="field-label">简介</view>
      <view class="bio-editor"><textarea class="bio-input" name="bio" value="{{bio}}" bindinput="onBioChange" maxlength="320" disabled="{{saving}}" placeholder="在你的个人资料中添加简介" placeholder-class="placeholder" /><view class="bio-count">{{bioLength}}/160</view></view>
    </view>
    <button size="mini" class="field-row location-row" bindtap="showLocationNotice" disabled="{{saving}}"><view class="field-label">位置</view><view class="placeholder field-value">添加你的位置</view><view class="row-chevron"></view></button>
    <view class="field-row birthday-row">
      <view class="field-label">出生日期</view>
      <picker class="date-picker" mode="date" start="1900-01-01" end="{{today}}" value="{{birthDate || today}}" bindchange="onBirthDateChange" disabled="{{saving}}"><view class="date-value {{birthDate ? '' : 'placeholder'}}">{{birthDate || '添加出生日期'}}<view class="row-chevron"></view></view></picker>
      <button wx:if="{{birthDate}}" size="mini" class="clear-date" bindtap="clearBirthDate" disabled="{{saving}}">清空</button>
    </view>
  </block>
  <view wx:else class="page-notice"><view>{{error || '请先登录后编辑资料'}}</view><button class="cs-secondary retry" bindtap="loadProfile">重新读取</button><button class="toolbar-button" bindtap="backToProfile">返回上一页</button></view>
</form>
