@import "../../styles/xiaocui-icon.wxss";
page { background: #f7f8fa; }
.ai-about-page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); color: #171b20; }
.ai-about-header { position: relative; background: #f7f8fa; }
.ai-about-nav { position: absolute; left: 0; right: 0; display: flex; align-items: center; }
.ai-about-title { position: absolute; left: 50%; transform: translateX(-50%); font-size: 31rpx; font-weight: 600; white-space: nowrap; }
.ai-about-page .ai-about-back { position: absolute; left: 22rpx; top: 0; display: flex; align-items: center; justify-content: center; width: 64rpx; min-width: 0; max-width: 64rpx; height: 100%; margin: 0; padding: 0; border: 0; border-radius: 0; box-sizing: border-box; line-height: 1; background: transparent; }
.ai-about-back-icon { display: block; flex-shrink: 0; width: 36rpx; height: 36rpx; }
.ai-about-page .ai-about-back-pressed { opacity: .55; }
.ai-about-page button::after { border: 0; }
.ai-about-content { padding: 0 32rpx; }
.ai-about-hero { display: flex; flex-direction: column; align-items: center; padding: 66rpx 0 60rpx; }
.ai-about-mark { display: flex; align-items: center; justify-content: center; width: 148rpx; height: 148rpx; border-radius: 46rpx; background: #e9f1ff; }
.ai-about-mark .xiaocui-icon { width: 112rpx; height: 112rpx; }
.ai-about-name { margin-top: 28rpx; font-size: 48rpx; font-weight: 700; line-height: 1.3; letter-spacing: 1rpx; }
.ai-about-tagline { margin-top: 16rpx; color: #707987; font-size: 27rpx; line-height: 1.6; }
.ai-usage-card { padding: 30rpx 32rpx 28rpx; border: 1rpx solid #edf0f4; border-radius: 30rpx; background: #fff; box-shadow: 0 8rpx 32rpx rgba(34, 57, 90, .025); }
.ai-usage-heading { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 64rpx; font-size: 31rpx; font-weight: 600; }
.ai-about-page .ai-usage-refresh { display: flex; flex: 0 0 64rpx; align-items: center; justify-content: center; width: 64rpx; min-width: 0; max-width: 64rpx; height: 64rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; box-sizing: border-box; line-height: 1; background: #f3f5f8; }
.ai-usage-refresh-icon { display: block; flex-shrink: 0; width: 32rpx; height: 32rpx; }
.ai-about-page .ai-usage-refresh-pressed { background: #e9edf3; }
.ai-about-page .ai-usage-refresh[disabled] { background: #f3f5f8; opacity: .65; }
.ai-usage-summary { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 36rpx; }
.ai-usage-label { font-size: 27rpx; color: #596574; }
.ai-usage-number { display: flex; align-items: baseline; gap: 10rpx; font-variant-numeric: tabular-nums; }
.ai-usage-number > text:first-child { font-size: 36rpx; line-height: 1.4; font-weight: 650; }
.ai-usage-number > text:last-child { font-size: 23rpx; color: #8b949f; }
.ai-usage-track { height: 14rpx; margin-top: 20rpx; overflow: hidden; border-radius: 20rpx; background: #edf1f7; }
.ai-usage-fill { height: 100%; border-radius: inherit; background: #4775fa; transition: width .35s ease, background .25s ease; }
.ai-usage-fill.is-low { background: #e46b66; }
.ai-usage-reset { display: flex; align-items: center; gap: 9rpx; margin-top: 25rpx; color: #929ba6; font-size: 23rpx; line-height: 1.6; }
.ai-usage-reset image { width: 25rpx; height: 25rpx; opacity: .8; }
.ai-usage-empty { display: flex; align-items: center; min-height: 108rpx; color: #929ba6; font-size: 26rpx; }
.ai-usage-skeleton { width: 100%; height: 14rpx; border-radius: 20rpx; background: #edf1f7; }
.ai-usage-error { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 18rpx; font-size: 23rpx; line-height: 1.6; color: #b96759; }
.ai-usage-error button { flex-shrink: 0; width: auto; min-width: 0; margin: 0; padding: 0 8rpx; color: #4775fa; background: transparent; font-size: 23rpx; line-height: 1.6; }
.ai-usage-exhausted { margin-top: 18rpx; color: #c2675b; font-size: 24rpx; line-height: 1.6; }
.ai-about-note { display: flex; flex-direction: column; align-items: center; gap: 8rpx; margin-top: 36rpx; color: #929ba6; font-size: 23rpx; line-height: 1.7; text-align: center; }
.is-refreshing { animation: ai-usage-refresh 1s linear infinite; }
@keyframes ai-usage-refresh { to { transform: rotate(360deg); } }
