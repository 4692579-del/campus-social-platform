@import "../../styles/search-toolbar.wxss";
@import "../../styles/account-avatar.wxss";
@import "../../styles/account-menu.wxss";
@import "../../styles/login-sheet.wxss";
page { height:100%; overflow:hidden; overscroll-behavior:none; background:#fff; }
.search-shell { position:relative; width:100%; height:100vh; overflow:hidden; }
.search-shell .tab-secondary-page { position:relative; left:0; transition:left .26s ease; }
.search-shell.menu-open .tab-secondary-page { left:66.666667vw; }
.search-shell.menu-instant .tab-secondary-page, .search-shell.menu-instant .profile-menu-layer,
.search-shell.menu-instant .menu-panel, .search-shell.menu-instant .menu-backdrop { transition:none; }
.search-page { display:flex; flex-direction:column; min-height:0; background:#fff; }
.search-discovery-frame { --search-return-gap:0rpx; position:relative; flex:1; min-height:0; margin-top:20rpx; }
.search-discovery-frame.is-refresh-returning { --search-return-gap:76rpx; }
.search-discovery { position:relative; z-index:1; top:var(--search-return-gap); width:100%; height:calc(100% - var(--search-return-gap)); overscroll-behavior-y:none; transition:top .16s ease, height .16s ease; }
.search-refresh-space { width:100%; pointer-events:none; }
.search-refresh-anchor { position:absolute; top:0; right:0; left:0; display:flex; align-items:center; justify-content:center; height:76rpx; pointer-events:none; }
.search-refresh-anchor .search-refresh-logo { display:block; width:104rpx; height:54rpx; }
.search-discovery-content { padding-bottom:calc(152rpx + env(safe-area-inset-bottom)); background:#fff; }
.search-board-tabs { position:-webkit-sticky; position:sticky; top:0; z-index:30; display:flex; height:84rpx; margin:0 24rpx; border-bottom:1rpx solid #e9ebf0; background:#fff; }
.search-board-tabs::before { content:''; position:absolute; left:-24rpx; right:-24rpx; top:0; bottom:0; z-index:-1; background:#fff; }
.board-tab { flex:1 1 0%; min-width:0; display:flex; align-items:center; justify-content:center; height:84rpx; color:#777c88; font-size:32rpx; font-weight:600; white-space:nowrap; }
.board-tab.selected { color:#15191d; font-weight:700; }
.board-tab-label { display:inline-flex; align-items:center; height:100%; padding-bottom:8rpx; box-sizing:border-box; }
.board-arrow { display:flex; align-items:center; justify-content:center; width:38rpx; height:100%; margin-right:-14rpx; }
.board-chevron { width:23rpx; height:23rpx; transition:transform .18s ease; }
.board-chevron.expanded { transform:rotate(180deg); }
.is-cui-board .board-indicator { bottom:-1rpx; }
.board-viewport { overflow:hidden; }
.board-panels { position:relative; display:flex; align-items:flex-start; width:300%; transition:left .26s ease; }
.board-panel { flex:0 0 33.333333%; width:33.333333%; height:0; min-width:0; overflow:hidden; box-sizing:border-box; padding:0 28rpx; }
.board-panel.is-active { height:auto; }
.board-panel.cui-board-panel { padding:0; }
.cui-promo-frame { position:relative; z-index:0; display:flex; align-items:center; justify-content:center; width:100%; height:421.875rpx; overflow:hidden; background:#f3f5f8; }
.cui-promo { display:block; width:100%; height:100%; }
.cui-promo-link { position:absolute; z-index:1; top:0; right:0; bottom:0; left:0; }
.cui-promo-credit { position:absolute; left:24rpx; bottom:20rpx; color:#fff; font-size:24rpx; font-weight:600; line-height:1.4; text-shadow:0 1rpx 6rpx rgba(0,0,0,.72); pointer-events:none; }
.cui-promo-sound { position:absolute; z-index:2; top:16rpx; right:16rpx; width:51.2rpx; height:51.2rpx; border-radius:25.6rpx; background:rgba(0,0,0,.44); }
.cui-promo-sound-icon { position:absolute; top:12rpx; left:12rpx; width:27.2rpx; height:27.2rpx; }
.cui-promo-status, .cui-promo-retry { font-size:26rpx; color:#737d8b; }
.cui-promo-retry { width:auto; margin:0; padding:0 24rpx; border-radius:100rpx; color:#4775fa; background:#fff; }
.cui-promo-retry::after { border:0; }
.cui-recommendations { padding:28rpx 0 16rpx; }
.cui-recommendations-title { padding:0 28rpx 20rpx; color:#687580; font-size:27rpx; font-weight:650; line-height:1.4; }
.cui-recommendations-scroll { width:100%; }
.cui-recommendations-track { display:inline-flex; gap:12rpx; padding:0 28rpx; vertical-align:top; }
.cui-recommendation { display:flex; flex:0 0 220rpx; flex-direction:column; align-items:center; gap:30.8rpx; box-sizing:border-box; width:220rpx; padding:17.6rpx; border-radius:24.64rpx; background:#f4f5f7; }
.cui-recommendation button { display:flex; align-items:center; justify-content:center; min-width:0; margin:0; padding:0; border:0; line-height:1; }
.cui-recommendation button::after { border:0; }
.cui-recommendation .cui-recommendation-avatar { width:126.72rpx; height:126.72rpx; border-radius:50%; overflow:hidden; background:#edf0f4; }
.cui-recommendation-avatar image { display:block; width:100%; height:100%; }
.cui-recommendation-name { max-width:100%; overflow:hidden; color:#171b20; font-size:24.64rpx; font-weight:650; line-height:33.44rpx; text-align:center; text-overflow:ellipsis; white-space:nowrap; }
.cui-recommendation .cui-recommendation-follow { width:100%; height:52.8rpx; border-radius:999rpx; background:#4775fa; color:#fff; font-size:22.88rpx; font-weight:650; }
.cui-recommendation .cui-recommendation-follow.is-following { background:#e8ebf0; color:#535963; }
.cui-recommendation-pressed { opacity:.75; }
.cui-hotboard { padding:16rpx 28rpx 0; }
.global-trends-banner { position:relative; overflow:hidden; box-sizing:border-box; min-height:230rpx; margin-top:24rpx; border-radius:20rpx; background:#040915; }
.global-trends-art { position:absolute; top:0; right:0; width:78%; height:100%; }
.global-trends-earth, .global-trends-glow, .global-trends-stars { position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; }
.global-trends-glow::before, .global-trends-glow::after { content:""; position:absolute; top:0; right:0; bottom:0; left:0; }
.global-trends-glow::before { background:radial-gradient(ellipse 19% 26% at 42% 55%,rgba(3,17,49,.72),transparent 100%); opacity:.28; }
.global-trends-glow::after { background:radial-gradient(ellipse 21% 20% at 42% 55%,rgba(196,235,255,.38),rgba(72,157,255,.18) 42%,transparent 100%); opacity:.22; }
.global-trends-banner::after { content:""; position:absolute; top:0; right:0; bottom:0; left:0; background:linear-gradient(90deg,#040915 12%,rgba(4,9,21,.88) 26%,rgba(4,9,21,.15) 59%,transparent 78%); pointer-events:none; }
.global-trends-content { position:relative; z-index:1; display:flex; flex-direction:column; align-items:flex-start; padding:30rpx 28rpx; color:#fff; }
.global-trends-title { font-size:34rpx; font-weight:700; line-height:1.2; }
.global-trends-subtitle { margin-top:8rpx; font-size:27rpx; line-height:1.35; }
.global-trends-explore { display:flex; align-items:center; justify-content:center; box-sizing:border-box; min-height:58rpx; margin-top:22rpx; padding:0 25rpx; border:1px solid #fff; border-radius:100rpx; font-size:26rpx; font-weight:600; }
.hot-source { padding:24rpx 0 4rpx; font-size:23rpx; color:#98a1ad; }
.hot-item { display:flex; align-items:center; min-height:94rpx; padding:22rpx 0; box-sizing:border-box; border-bottom:1rpx solid #f0f1f3; }
.hot-rank { flex:0 0 52rpx; width:52rpx; margin-right:10rpx; color:#9ca5b1; font-size:27rpx; line-height:40rpx; font-weight:600; font-variant-numeric:tabular-nums; }
.hot-rank.is-top { font-weight:700; transform:skewX(-8deg); transform-origin:0 50%; }
.hot-rank.rank-1 { color:#254cce; font-size:34rpx; }
.hot-rank.rank-2 { color:#3d65db; font-size:32rpx; }
.hot-rank.rank-3 { color:#5678dd; font-size:30rpx; }
.hot-title { flex:1; min-width:0; color:#282e36; font-size:28rpx; line-height:42rpx; overflow-wrap:break-word; }
.hot-empty { padding:72rpx 12rpx; text-align:center; color:#949da8; font-size:26rpx; }
.hot-warning { margin-top:20rpx; color:#8b949e; font-size:23rpx; line-height:1.6; }
.hot-error { display:flex; align-items:center; margin-top:28rpx; color:#8b949e; font-size:24rpx; line-height:1.6; }
.hot-error-text { flex:1; }.hot-retry { flex-shrink:0; padding:12rpx 4rpx 12rpx 24rpx; color:#4775fa; }
.hot-more { display:flex; align-items:center; justify-content:center; min-height:90rpx; color:#4775fa; font-size:26rpx; }
.hot-more-icon { width:25rpx; height:25rpx; margin-left:10rpx; }
.hot-end { padding:30rpx 0 4rpx; text-align:center; color:#a0a7b2; font-size:23rpx; }
.is-animated .global-trends-glow::before { animation:global-hotspot-dim 9s ease-in-out infinite; }
.is-animated .global-trends-glow::after { animation:global-hotspot-glow 9s ease-in-out infinite; }
@keyframes global-hotspot-dim { 0%,100% { opacity:.64; } 50% { opacity:0; } }
@keyframes global-hotspot-glow { 0%,100% { opacity:0; } 50% { opacity:.9; } }
@media (prefers-reduced-motion:reduce) {
  .board-panels,.board-chevron { transition:none; }
  .is-animated .global-trends-glow::before, .is-animated .global-trends-glow::after { animation:none; }
  .global-trends-stars { display:none; }
}
