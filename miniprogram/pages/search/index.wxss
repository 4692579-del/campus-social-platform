page { background: #fff; }
.search-page { min-height: 100vh; padding: 24rpx 28rpx; box-sizing: border-box; background: #fff; }
.search-field { display: flex; align-items: center; gap: 18rpx; height: 78rpx; padding: 0 24rpx; border-radius: 20rpx; background: #f1f3f5; box-sizing: border-box; }
.search-field image { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.search-field input { flex: 1; min-width: 0; height: 100%; color: #171b20; font-size: 29rpx; }
.search-placeholder { color: #8b949e; }
.search-notice { margin-top: 100rpx; text-align: center; color: #8b949e; font-size: 27rpx; }
