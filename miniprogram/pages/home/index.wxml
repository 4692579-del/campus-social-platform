<import src="../../templates/account-menu.wxml" />
<import src="../../templates/login-sheet.wxml" />
<view class="home-shell {{menuOpen ? 'menu-open' : ''}} {{menuInstant ? 'menu-instant' : ''}}">
  <button wx:if="{{!menuOpen}}" size="mini" class="home-avatar-button" style="top: {{navTop}}px; width: {{navButtonHeight}}px; height: {{navButtonHeight}}px;" bindtap="openMenu" aria-label="打开侧面菜单" aria-expanded="{{menuOpen}}"><image wx:if="{{user && user.avatarFileID && !avatarFailed}}" src="{{user.avatarFileID}}" mode="aspectFill" binderror="onAvatarError" /><image wx:else src="/images/avatar.png" mode="aspectFill" /></button>
  <view class="home-page" style="padding-top: {{navHeight}}px;">
    <view class="home-tabs" role="tablist" aria-label="首页板块">
      <button size="mini" wx:for="{{tabs}}" wx:key="key" class="home-tab {{activeTab === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="selectTab" aria-role="tab" aria-selected="{{activeTab === item.key}}" hover-class="none">{{item.label}}</button>
    </view>
    <scroll-view class="home-feed" scroll-y="{{!menuOpen && !commentPostId && !loginSheetOpen && !authChecking}}" enhanced show-scrollbar="{{false}}" enable-back-to-top refresher-enabled="{{activeTab === 'square' && !menuOpen && !commentPostId && !loginSheetOpen && !authChecking}}" refresher-triggered="{{pullRefreshing}}" refresher-threshold="48" refresher-default-style="none" refresher-background="#FFFFFF" bindrefresherrefresh="refreshFeed" bindscrolltolower="loadMoreFeed" lower-threshold="160">
    <block wx:if="{{activeTab === 'square'}}">
      <view wx:if="{{feedError}}" class="feed-error"><text>{{feedError}}</text><button size="mini" bindtap="retryFeed">重试</button></view>
      <block wx:if="{{feedLoading && !posts.length}}"><view wx:for="{{skeletons}}" wx:key="*this" class="feed-skeleton"><view class="skeleton-avatar"></view><view class="skeleton-body"><view></view><view></view><view></view></view></view></block>
      <block wx:else><square-post wx:for="{{posts}}" wx:key="_id" post="{{item}}" viewer="{{user}}" bind:reply="openComments" bind:react="reactPost" bind:more="managePost" bind:share="prepareShare" /><view wx:if="{{!posts.length && !feedError}}" class="feed-empty"><view class="empty-heading">广场还很安静</view><view class="empty-caption">分享一个想法，开启第一段对话</view><button size="mini" class="empty-publish" bindtap="openComposer">发布第一条动态</button></view><view wx:if="{{feedMoreLoading}}" class="feed-end">正在加载…</view><view wx:elif="{{posts.length && !feedHasMore}}" class="feed-end">已经看到这里了</view></block>
    </block>
    <view wx:elif="{{activeTab === 'following'}}" class="feed-empty"><view class="empty-heading">关注你感兴趣的人</view><view class="empty-caption">关注动态将在后续开放</view></view>
    <view wx:else class="feed-empty"><view class="empty-heading">你的校园，你的圈子</view><view class="empty-caption">{{identity.isStudent ? '校园圈将在后续开放' : '完成学校认证后，即可加入校园圈'}}</view><button wx:if="{{!identity.isStudent}}" size="mini" class="empty-publish" bindtap="openCampusCertification">去认证</button></view>
    <view slot="refresher" class="home-refresh" role="status" aria-label="正在刷新动态"><view class="home-refresh-spinner"></view></view>
    </scroll-view>
  </view>
  <button wx:if="{{activeTab === 'square' && !menuOpen && !loginSheetOpen && !authChecking}}" size="mini" class="home-compose-button" bindtap="openComposer" aria-label="发布动态"><image src="/images/interface/feather-white.svg" /></button>
  <template is="account-menu" data="{{user: user, accountHint: accountHint, menuOpen: menuOpen, navHeight: navHeight, followerCount: followerCount, followingCount: followingCount, menuItems: menuItems, utilityMenuItems: utilityMenuItems, loading: loading, coverBusy: false, confirmingLogout: confirmingLogout}}" />
  <template is="login-sheet" data="{{authChecking: authChecking, loginSheetOpen: loginSheetOpen, error: error, loading: loading}}" />
  <comments-sheet wx:if="{{commentPostId}}" post-id="{{commentPostId}}" viewer="{{user}}" bind:close="closeComments" bind:login="commentLogin" bind:changed="commentChanged" />
</view>
