@import "../../styles/account-menu.wxss";
@import "../../styles/login-sheet.wxss";
page { background: #fff; }
.home-shell { position: relative; width: 100%; height: 100vh; overflow: hidden; }
.home-page { display: flex; flex-direction: column; width: 100%; height: 100vh; box-sizing: border-box; background: #fff; color: #15191d; }
.home-page { position: relative; left: 0; transition: left 0.26s ease; }
.home-header { position: absolute; z-index: 150; left: 0; right: 0; top: 0; height: var(--home-header-height); box-sizing: border-box; background: #fff; transform: translateY(0); transition: transform 280ms cubic-bezier(.22,.75,.3,1); }
.home-header.dropdown-open { z-index: 180; }
.home-status-cover { position: absolute; z-index: 160; left: 0; right: 0; top: 0; background: #fff; pointer-events: none; }
/* 不把含有增强滚动及图片轮播的整页长期提升为变换合成层。 */
.home-shell.menu-open .home-page { left: 66.666667vw; }
.home-shell.menu-instant .home-page, .home-shell.menu-instant .profile-menu-layer, .home-shell.menu-instant .menu-panel, .home-shell.menu-instant .menu-backdrop { transition: none; }
.home-shell .home-avatar-button { position: absolute; z-index: 150; left: 24rpx; display: block; min-width: 0; margin: 0; padding: 0; border: 0; border-radius: 50%; overflow: hidden; background: #f1f3f5; line-height: 1; transition: transform 0.26s ease; }
.home-avatar-button::after { border: 0; }
.home-avatar-button image { display: block; width: 100%; height: 100%; }
.home-avatar-button .home-avatar-image { position: absolute; inset: 0; opacity: 0; }
.home-avatar-button .home-avatar-image.is-ready { opacity: 1; }
.home-shell.menu-open .home-avatar-button { opacity: 0; pointer-events: none; }
.home-shell .home-brand-button { position: absolute; z-index: 150; left: 50%; transform: translateX(-50%); display: flex; align-items: center; justify-content: center; width: 120rpx; min-width: 0; margin: 0; padding: 0; border: 0; border-radius: 0; overflow: visible; background: transparent; line-height: 1; }
.home-brand-button::after { border: 0; }
/* 刷新期间按钮禁用，覆盖小程序默认 disabled 矩形灰底。 */
.home-shell .home-brand-button[disabled] { background: transparent; }
.home-brand-art { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 54rpx; max-width: 100%; max-height: 84%; transform-origin: 50% 60%; }
.home-brand-icon { display: block; width: 100%; height: 100%; }
.home-brand-art.is-bouncing { animation: home-brand-bounce .4s cubic-bezier(.22, .7, .28, 1) both; will-change: transform; }
.home-shell.menu-open .home-brand-button { opacity: 0; pointer-events: none; }
.home-feed-top { height: calc(var(--home-header-height) - var(--home-safe-top) + 1rpx); pointer-events: none; }
.home-feed-bottom { height: calc(128rpx + constant(safe-area-inset-bottom) + var(--home-safe-top)); height: calc(128rpx + env(safe-area-inset-bottom) + var(--home-safe-top)); pointer-events: none; }
@keyframes home-brand-bounce { 0%, 100% { transform: scale(1); } 28% { transform: scale(.82, .88); } 58% { transform: scale(1.08, 1.04); } 76% { transform: scale(.98, 1.015); } 90% { transform: scale(1.012, .994); } }
@media (prefers-reduced-motion: reduce) { .home-brand-art.is-bouncing { animation: none; } }
.home-tabs { position: relative; display: flex; align-items: stretch; flex-shrink: 0; margin: 4rpx 24rpx 0; border-bottom: 1rpx solid #e9ebf0; background: #fff; }
/* 滚动节点的位置、高度及头部留白固定，收起标题栏不会额外推移正在拖动的内容。 */
.home-panels-viewport { position: absolute; left: 0; top: var(--home-safe-top); width: 100%; height: 100%; min-height: 0; overflow: hidden; }
@media (prefers-reduced-motion: reduce) { .home-header { transition: none; } }
.home-panels { position: relative; left: 0; display: flex; width: 200%; height: 100%; transition: left .26s ease; }
.home-panels.show-campus { left: -100%; }
.home-feed { flex: 0 0 50%; width: 50%; height: 100%; min-width: 0; min-height: 0; }
.home-page .home-tab { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; height: 84rpx; margin: 0; padding: 0 8rpx; box-sizing: border-box; border: 0; border-radius: 0; background: #fff; color: #777c88; font-size: 32rpx; font-weight: 600; line-height: 1.4; white-space: nowrap; }
.home-tab::after { border: 0; }
.home-page .home-tab.selected { color: #15191d; font-weight: 700; }
.home-tab-label { position: relative; display: inline-flex; align-items: center; height: 100%; padding-bottom: 8rpx; box-sizing: border-box; }
.home-tab-indicator { position: absolute; z-index: 2; bottom: 0; height: 6rpx; border-radius: 6rpx; background: #4775fa; pointer-events: none; transition: left .26s ease, width .26s ease; }
.home-refresh-space { width: 100%; height: 72px; background: #fff; pointer-events: none; }
.feed-empty { padding: 110rpx 40rpx; text-align: center; }
.empty-heading { font-size: 36rpx; font-weight: 700; color: #171b20; }
.empty-caption { margin-top: 18rpx; font-size: 27rpx; line-height: 1.7; color: #98a1ad; }
.home-page .empty-publish { display: inline-flex; align-items: center; justify-content: center; height: 72rpx; margin: 34rpx 0 0; padding: 0 32rpx; border: 0; border-radius: 18rpx; background: #4775fa; color: #fff; font-size: 28rpx; font-weight: 600; line-height: 1; }
.feed-error { display: flex; align-items: center; gap: 20rpx; margin: 24rpx; padding: 20rpx; border-radius: 16rpx; background: #fff4f1; color: #a44130; font-size: 25rpx; }
.feed-error text { flex: 1; }
.home-page .feed-error button { flex-shrink: 0; margin: 0; padding: 0 8rpx; background: transparent; color: #4775fa; font-size: 25rpx; line-height: 1.8; }
.feed-end { padding: 32rpx; text-align: center; color: #a5adb7; font-size: 24rpx; }
.feed-skeleton { display: flex; gap: 20rpx; padding: 30rpx 28rpx; border-bottom: 1rpx solid #edf0f3; }
.skeleton-avatar { width: 76rpx; height: 76rpx; border-radius: 50%; background: #f1f3f5; }
.skeleton-body { flex: 1; }
.skeleton-body view { height: 22rpx; margin: 8rpx 0 22rpx; border-radius: 8rpx; background: #f1f3f5; }
.skeleton-body view:first-child { width: 45%; }
.skeleton-body view:last-child { width: 75%; }

.home-tab-group { position: relative; flex: 1 1 0; min-width: 0; }
.home-tab-group .tab-dropdown { width: 150rpx; }
.home-tabs.dropdown-open { z-index: 180; }
.home-dropdown-backdrop { position: fixed; z-index: 170; inset: 0; background: transparent; }
.home-tab-arrow { display: flex; align-items: center; justify-content: center; align-self: stretch; width: 48rpx; margin-right: -12rpx; }
