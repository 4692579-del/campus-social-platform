@import "../../styles/account-menu.wxss";
@import "../../styles/login-sheet.wxss";
page { background: #fff; }
.home-shell { position: relative; width: 100%; height: 100vh; overflow: hidden; }
.home-page { display: flex; flex-direction: column; width: 100%; height: 100vh; padding-bottom: calc(89rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #fff; color: #15191d; }
.home-page { transition: transform 0.26s ease; }
.home-shell.menu-open .home-page { transform: translateX(66.666667vw); }
.home-shell.menu-instant .home-page, .home-shell.menu-instant .profile-menu-layer, .home-shell.menu-instant .menu-panel, .home-shell.menu-instant .menu-backdrop { transition: none; }
.home-shell .home-avatar-button { position: fixed; z-index: 150; left: 24rpx; display: block; min-width: 0; margin: 0; padding: 0; border: 0; border-radius: 50%; overflow: hidden; background: #f1f3f5; line-height: 1; transition: transform 0.26s ease; }
.home-avatar-button::after { border: 0; }
.home-avatar-button image { display: block; width: 100%; height: 100%; }
.home-tabs { display: flex; align-items: stretch; flex-shrink: 0; margin: 12rpx 24rpx 0; border-bottom: 1rpx solid #e9ebf0; background: #fff; }
.home-feed { flex: 1; width: 100%; height: 0; min-height: 0; }
.home-page .home-tab { position: relative; display: flex; align-items: center; justify-content: center; flex: 1 1 0; width: 0; min-width: 0; height: 96rpx; margin: 0; padding: 0 8rpx 8rpx; box-sizing: border-box; border: 0; border-radius: 0; background: #fff; color: #777c88; font-size: 32rpx; font-weight: 600; line-height: 1.4; white-space: nowrap; }
.home-tab::after { border: 0; }
.home-page .home-tab.selected { color: #15191d; font-weight: 700; }
.home-tab.selected::before { content: ''; position: absolute; left: 50%; bottom: 0; width: 68rpx; height: 6rpx; border-radius: 6rpx; background: #4775fa; transform: translateX(-50%); }
.home-refresh { display: flex; align-items: center; justify-content: center; width: 100%; height: 48px; background: #fff; pointer-events: none; }
.home-refresh-spinner { width: 32rpx; height: 32rpx; box-sizing: border-box; border: 4rpx solid #e4ebff; border-top-color: #4775fa; border-right-color: #4775fa; border-radius: 50%; animation: refresh-spin .7s linear infinite; }
@keyframes refresh-spin { to { transform: rotate(360deg); } }
.home-shell .home-compose-button { position: fixed; right: 32rpx; bottom: calc(132rpx + env(safe-area-inset-bottom)); z-index: 160; display: flex; align-items: center; justify-content: center; width: 100rpx; height: 100rpx; min-width: 0; margin: 0; padding: 0; border: 0; border-radius: 50%; background: #4775fa; box-shadow: 0 8rpx 24rpx rgba(71,117,250,.24); line-height: 1; }
.home-compose-button::after { border: 0; }
.home-compose-button image { width: 46rpx; height: 46rpx; }
.feed-empty { padding: 110rpx 40rpx; text-align: center; }
.empty-heading { font-size: 36rpx; font-weight: 700; color: #171b20; }
.empty-caption { margin-top: 18rpx; font-size: 27rpx; line-height: 1.7; color: #98a1ad; }
.home-page .empty-publish { display: inline-flex; align-items: center; justify-content: center; height: 72rpx; margin: 34rpx 0 0; padding: 0 32rpx; border: 0; border-radius: 18rpx; background: #4775fa; color: #fff; font-size: 28rpx; font-weight: 600; line-height: 1; }
.feed-error { display: flex; align-items: center; gap: 20rpx; margin: 24rpx; padding: 20rpx; border-radius: 16rpx; background: #fff4f1; color: #a44130; font-size: 25rpx; }
.feed-error text { flex: 1; }
.home-page .feed-error button { flex-shrink: 0; margin: 0; padding: 0 8rpx; background: transparent; color: #4775fa; font-size: 25rpx; line-height: 1.8; }
.feed-end { padding: 32rpx; text-align: center; color: #a5adb7; font-size: 24rpx; }
.feed-skeleton { display: flex; gap: 20rpx; padding: 30rpx 28rpx; border-bottom: 1rpx solid #edf0f3; }
.skeleton-avatar { width: 76rpx; height: 76rpx; border-radius: 50%; background: #f1f3f5; }
.skeleton-body { flex: 1; }
.skeleton-body view { height: 22rpx; margin: 8rpx 0 22rpx; border-radius: 8rpx; background: #f1f3f5; }
.skeleton-body view:first-child { width: 45%; }
.skeleton-body view:last-child { width: 75%; }
