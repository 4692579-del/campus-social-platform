.intro-card { background: #fff4c6; }
.intro-title { margin: 20rpx 0 16rpx; }
.field-label { font-size: 28rpx; font-weight: 600; margin: 30rpx 0 16rpx; }
.field-input { box-sizing: border-box; width: 100%; background: #f6f6f6; height: 92rpx; padding: 0 22rpx; border-radius: 16rpx; font-size: 28rpx; }
.detail-row { display: flex; justify-content: space-between; gap: 20rpx; margin-top: 24rpx; font-size: 26rpx; line-height: 1.7; }
.detail-label { flex-shrink: 0; color: #777; }
.detail-value { text-align: right; word-break: break-all; }
.material-hint { margin: 20rpx 0 24rpx; }
.material-caption { margin-top: 18rpx; font-size: 23rpx; }
.proof-image { display: block; width: 100%; height: 320rpx; background: #f6f6f6; margin-bottom: 24rpx; border-radius: 16rpx; }
.agreement { display: flex; align-items: flex-start; font-size: 24rpx; color: #777; line-height: 1.8; margin: 8rpx 0 28rpx; }
.agreement checkbox { flex-shrink: 0; transform: scale(.8); transform-origin: left top; }
.rejection { margin-top: 24rpx; padding: 22rpx; background: #fff2ed; color: #a44127; border-radius: 16rpx; font-size: 26rpx; line-height: 1.7; }
.back-button { margin-top: 24rpx; }
