<import src="../../templates/login-sheet.wxml" />
<wxs src="../../components/square-post/action-count.wxs" module="profileCount" />
<view class="profile-shell">
  <view class="profile-navigation {{navBlurOpacity === 0 ? 'is-clear' : ''}}" style="height: {{navHeight}}px;">
    <view class="profile-nav-background" aria-hidden="true">
      <view class="profile-nav-blur" style="opacity: {{navBlurOpacity}};">
        <view class="profile-nav-scene blurred-cover" style="height: {{coverArtHeight}}px; transform: translateY(-{{navCoverOffset}}px);">
          <image wx:if="{{coverFileID && !coverFailed}}" class="cover-image" src="{{coverFileID}}" mode="aspectFill" />
        </view>
      </view>
      <view class="profile-nav-tint" style="opacity: {{navShadeOpacity}};"></view>
    </view>
    <view class="profile-header-controls" style="top: {{navTop - 4}}px; height: {{navButtonHeight + 8}}px;">
      <button size="mini" class="profile-menu-toggle" style="width: {{navButtonHeight + 8}}px; height: {{navButtonHeight + 8}}px;" bindtap="backToHome" aria-label="返回"><image src="/images/interface/chevron-left-white.svg" mode="aspectFit" /></button>
      <view class="profile-nav-title" style="left: {{navTitleInset}}px; right: {{navTitleInset}}px; opacity: {{navTitleOpacity}};" aria-hidden="{{navTitleOpacity === 0}}"><text class="profile-nav-name">{{profileUser.nickname}}</text><text class="profile-nav-count">{{postCountText}}</text></view>
      <button size="mini" class="profile-search-button" style="left: {{searchLeft}}px; width: {{navButtonHeight + 8}}px; height: {{navButtonHeight + 8}}px;" bindtap="openSearch" aria-label="搜索"><image src="/images/interface/search-white.svg" mode="aspectFit" /></button>
    </view>
  </view>
  <scroll-view class="profile-scroll" scroll-y="{{!authChecking && !loginSheetOpen && !commentPostId && !postsMenuOpen && !mediaMenuOpen && !composerOpen && !unfollowTarget}}" enhanced bounces="{{false}}" show-scrollbar="{{false}}" enable-back-to-top bindscroll="onProfileScroll" bindscrolltoupper="onProfileScrollUpper" upper-threshold="1" bindscrolltolower="loadMoreOwnPosts" lower-threshold="160" bindtouchstart="startProfilePull" bindtouchmove="moveProfilePull" bindtouchend="finishProfilePull" bindtouchcancel="cancelProfilePull">
  <view class="profile-page">
  <view class="profile-cover" style="height: {{coverHeight}}px;">
    <view class="profile-cover-art" style="height: {{coverArtHeight}}px;">
    <image wx:if="{{coverFileID && !coverFailed}}" class="cover-image" src="{{coverFileID}}" mode="aspectFill" binderror="onCoverError" />
    <view class="cover-shade"></view>
    </view>
    <view wx:if="{{profileRefreshPhase !== 'idle'}}" class="profile-pull-indicator {{pullDragging ? 'is-pulling' : ''}}" style="top: calc({{coverHeight + profilePullOffset / 2}}px - 108rpx); opacity: {{profileRefreshPhase === 'pulling' ? pullOpacity : 1}};" role="status" aria-label="{{profileRefreshing ? '正在刷新' : '下拉刷新'}}"><cui-refresh id="profile-cui" bind:ready="onProfileCuiReady" /></view>
  </view>

  <view class="profile-white {{pullDragging ? 'is-pulling' : ''}}" style="transform: translateY({{profilePullOffset}}px);">
  <view class="profile-body">
    <view class="profile-avatar-row">
      <view class="profile-avatar"><image class="profile-avatar-photo avatar-outline" src="{{profileUser.avatarFileID || '/images/avatar.png'}}" mode="aspectFill" /></view>
      <button wx:if="{{isVisitor && user && profileUser.accountId && !profileUnavailable}}" class="profile-user-menu" bindtap="openProfileUserMenu" aria-label="更多用户操作" hover-class="visitor-action-pressed"><image src="/images/interface/menu-two.svg" mode="aspectFit" aria-hidden="true" /></button>
    </view>
    <view wx:if="{{error && !loginSheetOpen}}" class="cs-error profile-error">{{error}}<button class="retry" bindtap="refresh" disabled="{{loading || coverBusy}}">重新读取</button></view>
    <view class="profile-heading">
      <view class="nickname">{{profileUnavailable ? '该用户暂不可查看' : profileUser ? profileUser.nickname : loading ? '正在读取资料…' : isVisitor ? '个人主页' : '你好，新同学'}}</view>
      <view wx:if="{{profileUser.officialVerified || profileUser.accountId === '19090448' || profileUser.accountId === '58732480' || profileUser.accountId === '45214114'}}" class="verified-badge"><image class="verification-icon" src="/images/verification/verified.png" mode="aspectFit" /><text>Cui官方</text></view>
      <view wx:elif="{{isVerified}}" class="profile-student-badge" bindtap="openCertification" aria-role="{{isVisitor ? 'img' : 'button'}}" aria-label="学生已认证"><image src="/images/verification/student.svg" mode="aspectFit" /></view>
      <view wx:elif="{{!isVisitor && identity.isAdmin}}" class="role-badge">管理员</view>
      <view wx:elif="{{profileUser && !isVisitor}}" class="verified-badge unverified-badge" bindtap="openCertification" aria-role="button" aria-label="未认证，查看学校认证"><image class="verification-icon" src="/images/verification/unverified.png" mode="aspectFit" /><text>未认证</text></view>
    </view>
    <view wx:if="{{profileUser.accountId}}" class="profile-account">@{{profileUser.accountId}}</view>
    <view wx:if="{{profileUser.bio}}" class="profile-bio">{{profileUser.bio}}</view>
    <view wx:if="{{joinedText}}" class="joined-row" bindtap="openAccountAbout" aria-role="button" aria-label="查看关于此账号"><image class="calendar-icon" src="/images/interface/calendar-muted.svg" mode="aspectFit" /><text>{{joinedText}}</text><image class="account-chevron" src="/images/interface/chevron-right-muted.svg" mode="aspectFit" /></view>
    <view wx:if="{{!profileUnavailable}}" class="profile-stats"><view><text class="stat-count">{{profileUser.officialVerified ? profileCount.formatKnown(likeCount) : likeCount}}</text><text>获赞</text></view><view><text class="stat-count">{{followingCount}}</text><text>关注</text></view><view><text class="stat-count">{{profileUser.officialVerified ? profileCount.formatKnown(followerCount) : followerCount}}</text><text>粉丝</text></view></view>

    <view wx:if="{{isVisitor && user && profileUser && !profileUnavailable && !profileBlocked}}" class="visitor-actions {{profileFollowing ? 'is-followed' : ''}}">
      <view class="visitor-follow-group">
        <button class="visitor-follow" bindtap="toggleProfileFollow" hover-class="visitor-action-pressed">{{profileFollowing ? '已关注' : '关注'}}</button>
        <view class="visitor-message-slot"><button class="visitor-message" bindtap="openProfileMessage" disabled="{{!profileFollowing}}" aria-hidden="{{!profileFollowing}}" hover-class="visitor-action-pressed">私信</button></view>
      </view>
      <button size="mini" class="profile-action share-action" bindtap="shareProfile" aria-label="分享主页" hover-class="visitor-action-pressed"><image class="share-icon" src="/images/interface/profile-share.svg" mode="aspectFit" /></button>
    </view>
    <view wx:if="{{isVisitor && followError}}" class="follow-error">{{followError}}</view>
    <view wx:if="{{user && !isVisitor}}" class="profile-actions">
      <button size="mini" wx:if="{{identity.isAdmin}}" class="profile-action" bindtap="openAdmin">管理工作台</button>
      <button size="mini" wx:elif="{{!isVerified && !profileUser.officialVerified}}" class="profile-action primary-profile-action" bindtap="openCertification">{{certificationAction}}</button>
      <button size="mini" wx:else class="profile-action primary-profile-action" bindtap="publishPost">发布动态</button>
      <button size="mini" class="profile-action" bindtap="editProfile" disabled="{{coverBusy}}">编辑资料</button>
      <button size="mini" class="profile-action share-action" bindtap="shareProfile" aria-label="分享主页"><image class="share-icon" src="/images/interface/profile-share.svg" mode="aspectFit" /></button>
    </view>
  </view>

  <view wx:if="{{!profileUnavailable}}" class="profile-timeline" style="min-height: calc(100vh - {{navHeight}}px);">
  <view wx:if="{{postsMenuOpen || mediaMenuOpen}}" class="posts-menu-backdrop" bindtap="closePostsMenu" catchtouchmove="stopMenuEvent"></view>
  <view class="content-tabs {{postsMenuOpen || mediaMenuOpen ? 'posts-menu-open' : ''}}" style="top: {{navHeight}}px;" role="tablist">
    <button wx:for="{{contentTabs}}" wx:key="key" class="content-tab {{selectedContent === item.key ? 'selected' : ''}}" bindtap="selectContent" data-key="{{item.key}}" aria-label="{{item.key === 'album' && mediaTab === 'videos' ? '视频' : item.label}}" aria-role="tab" aria-selected="{{selectedContent === item.key}}">
      <image class="content-tab-icon" src="{{item.key === 'album' && mediaTab === 'videos' ? '/images/profile-tabs/videos' : item.iconSource || '/images/tab-bar/' + item.icon}}{{selectedContent === item.key ? '-active' : ''}}.{{item.iconExtension || 'png'}}" mode="aspectFit" />
      <text wx:if="{{selectedContent === item.key}}" class="content-tab-label">{{item.key === 'album' && mediaTab === 'videos' ? '视频' : item.label}}</text>
      <image wx:if="{{!isVisitor && item.key === 'posts' && selectedContent === 'posts'}}" class="tab-dropdown-chevron {{postsMenuOpen ? 'expanded' : ''}}" src="/images/interface/chevron-down-muted.svg" mode="aspectFit" />
      <view wx:if="{{item.key === 'album' && !profileBlocked}}" class="media-menu-trigger" catchtap="toggleMediaMenu" aria-role="button" aria-label="切换相册或视频" aria-expanded="{{mediaMenuOpen}}"><image class="tab-dropdown-chevron {{mediaMenuOpen ? 'expanded' : ''}}" src="/images/interface/chevron-down-muted.svg" mode="aspectFit" /></view>
    </button>
    <view class="content-tab-indicator" style="left: {{contentIndex * 25 + 4.5}}%;" aria-hidden="true"></view>
    <view wx:if="{{postsMenuOpen}}" class="posts-menu tab-dropdown" aria-label="动态来源">
      <button class="tab-dropdown-option {{postScope === 'square' ? 'active' : ''}}" data-scope="square" bindtap="selectPostScope" aria-label="广场动态" aria-pressed="{{postScope === 'square'}}">动态广场</button>
      <button class="tab-dropdown-option {{postScope === 'campus' ? 'active' : ''}}" data-scope="campus" bindtap="selectPostScope" aria-label="校园圈" aria-pressed="{{postScope === 'campus'}}">校园圈</button>
    </view>
    <view wx:if="{{mediaMenuOpen}}" class="media-menu tab-dropdown" aria-label="切换相册或视频">
      <button class="tab-dropdown-option {{mediaTab === 'album' ? 'active' : ''}}" data-media="album" bindtap="selectMediaTab" aria-pressed="{{mediaTab === 'album'}}">相册</button>
      <button class="tab-dropdown-option {{mediaTab === 'videos' ? 'active' : ''}}" data-media="videos" bindtap="selectMediaTab" aria-pressed="{{mediaTab === 'videos'}}">视频</button>
    </view>
  </view>
  <view class="profile-panels-viewport" style="min-height: calc(100vh - {{navHeight}}px - 94rpx);">
  <view wx:if="{{profileBlocked}}" class="profile-blocked" role="status">
    <image src="/images/interface/user-block.svg" mode="aspectFit" aria-hidden="true" />
    <text>对方已被你拉黑</text>
  </view>
  <view wx:else class="profile-panels" style="left: {{-contentIndex * 100}}%;">
  <view class="profile-panel {{selectedContent === 'posts' ? 'is-active' : ''}}" style="left: 0%;" aria-hidden="{{selectedContent !== 'posts'}}">
  <block wx:if="{{postScope === 'square'}}">
    <view wx:if="{{postsError}}" class="profile-post-error"><text>{{postsError}}</text><button size="mini" bindtap="retryOwnPosts">重试</button></view>
    <view wx:if="{{postsLoading && !ownPosts.length}}" class="content-empty"><view class="empty-title">正在读取动态…</view></view>
    <block wx:else>
      <square-post wx:for="{{ownPosts}}" wx:key="_id" post="{{item}}" viewer="{{user}}" bind:author="viewAuthorProfile" profile-posts="{{!isVisitor && selectedContent === 'posts' && postScope === 'square'}}"
        seven-line-preview="{{profileUser.officialVerified || item.author.officialVerified}}"
        feed-video-enabled="{{(profileUser.officialVerified || item.author.officialVerified) && selectedContent === 'posts' && !profileUnavailable && !menuOpen && !authChecking && !loginSheetOpen && !commentPostId && !postsMenuOpen && !mediaMenuOpen && !composerOpen && !unfollowTarget}}"
        pinned="{{item._id === pinnedPostId}}" show-pin="{{isVisitor}}" like-motion="{{true}}" bind:open="openPost" bind:reply="openComments" bind:react="reactPost" bind:more="managePost" bind:quote="quotePost" />
      <view wx:if="{{!ownPosts.length && !postsError}}" class="content-empty"><view class="empty-title">还没有发布广场动态</view></view>
      <view wx:if="{{postsMoreLoading}}" class="profile-post-end">正在加载…</view>
      <view wx:elif="{{ownPosts.length && !postsHasMore}}" class="profile-post-end">已经看到这里了</view>
    </block>
  </block>
  <view wx:else class="content-empty"><view class="empty-title">{{isVerified ? '校园圈动态将在后续开放' : '完成学校认证后，即可加入校园圈'}}</view></view>
  </view>
  <view class="profile-panel {{selectedContent === 'replies' ? 'is-active' : ''}}" style="left: 25%;" aria-hidden="{{selectedContent !== 'replies'}}">
    <profile-replies bind:unavailable="publicProfileUnavailable" bind:author="viewAuthorProfile" id="profile-replies" account-id="{{isVisitor ? profileAccountId : ''}}" active="{{selectedContent === 'replies' && !profileUnavailable}}" viewer="{{user}}" bind:open="openHistoryPost" bind:reply="replyToHistory" />
  </view>
  <view class="profile-panel {{selectedContent === 'reposts' ? 'is-active' : ''}}" style="left: 50%;" aria-hidden="{{selectedContent !== 'reposts'}}">
    <view wx:if="{{quotesError}}" class="profile-post-error"><text>{{quotesError}}</text><button size="mini" bindtap="retryOwnQuotes">重试</button></view>
    <view wx:if="{{quotesLoading && !quotePosts.length}}" class="content-empty"><view class="empty-title">正在读取引用…</view></view>
    <block wx:else>
      <square-post wx:for="{{quotePosts}}" wx:key="_id" post="{{item}}" viewer="{{user}}" bind:author="viewAuthorProfile" bind:open="openPost" bind:reply="openComments" bind:react="reactPost" bind:more="managePost" bind:quote="quotePost" />
      <view wx:if="{{!quotePosts.length && !quotesError}}" class="content-empty"><view class="empty-title">{{contentTabs[2].empty}}</view></view>
      <view wx:if="{{quotesMoreLoading}}" class="profile-post-end">正在加载…</view>
      <view wx:elif="{{quotePosts.length && !quotesHasMore}}" class="profile-post-end">已经看到这里了</view>
    </block>
  </view>
  <view class="profile-panel {{selectedContent === 'album' ? 'is-active' : ''}}" style="left: 75%;" aria-hidden="{{selectedContent !== 'album'}}">
    <view hidden="{{mediaTab !== 'album'}}">
    <view wx:if="{{albumError}}" class="profile-post-error"><text>{{albumError}}</text><button bindtap="retryAlbum">重试</button></view>
    <view class="profile-album"><media-image class="profile-album-photo" wx:for="{{albumImages}}" wx:key="_id" src="{{item.fileID}}" mode="aspectFill" lazy-load data-index="{{index}}" bindtap="previewAlbum" /></view>
    <view wx:if="{{albumLoading && !albumImages.length}}" class="profile-post-end">正在读取相册…</view>
    <view wx:elif="{{!albumImages.length && !albumError}}" class="content-empty"><view class="empty-title">还没有发布图片</view></view>
    <view wx:if="{{albumMoreLoading}}" class="profile-post-end">正在加载…</view>
    <button wx:elif="{{albumHasMore}}" class="album-more" bindtap="loadMoreOwnPosts">加载更多图片</button>
    </view>
    <view hidden="{{mediaTab !== 'videos'}}" class="profile-videos">
      <view wx:if="{{videosError}}" class="profile-post-error"><text>{{videosError}}</text><button bindtap="retryProfileVideos">重试</button></view>
      <view wx:for="{{videos}}" wx:key="_id" class="profile-video-row" data-post="{{item.postId}}" bindtap="openVideoPost">
        <view class="profile-video-cover" data-id="{{item._id}}" catchtap="playProfileVideo" aria-role="button" aria-label="播放视频">
          <media-image wx:if="{{item.poster}}" src="{{item.poster}}" mode="aspectFit" lazy-load />
          <video wx:if="{{videoPlayback.id === item._id && videoPlayback.src}}" class="profile-video-player {{videoPlayback.ready ? 'is-ready' : ''}}"
            src="{{videoPlayback.src}}" data-token="{{videoPlayback.token}}" autoplay controls object-fit="contain" show-center-play-btn="{{false}}" show-fullscreen-btn="{{false}}" enable-progress-gesture="{{false}}"
            bindtimeupdate="profileVideoStarted" bindended="profileVideoEnded" binderror="profileVideoError" />
          <view wx:if="{{videoPlayback.id === item._id && !videoPlayback.ready}}" class="profile-video-loading" aria-label="正在加载视频">
            <image src="/images/interface/video-loading.svg" mode="aspectFit" />
          </view>
          <view wx:elif="{{videoPlayback.id !== item._id}}" class="post-play-badge" aria-hidden="true"></view>
        </view>
        <view class="profile-video-caption" aria-role="button" aria-label="查看动态详情">
          <text wx:if="{{item.content}}" class="profile-video-text">{{item.content}}</text>
          <text class="profile-video-time" aria-label="{{item.exactTime}}">{{item.timeText}}</text>
        </view>
      </view>
      <view wx:if="{{videosLoading && !videos.length}}" class="profile-post-end">正在读取视频…</view>
      <view wx:elif="{{!videos.length && !videosError && !videosHasMore}}" class="content-empty"><text class="empty-title">还没有发布视频</text></view>
      <view wx:if="{{videosMoreLoading}}" class="profile-post-end">正在加载…</view>
      <button wx:elif="{{videosHasMore && !videosError}}" class="album-more" bindtap="loadMoreOwnPosts">加载更多视频</button>
    </view>
  </view>
  </view>
  </view>
  </view>
  </view>
  </view>
  </scroll-view>
  <template is="login-sheet" data="{{authChecking: authChecking, loginSheetOpen: loginSheetOpen, error: error, loading: loading}}" />
  <comments-sheet bind:author="viewAuthorProfile" id="active-comments" wx:if="{{commentPostId}}" post-id="{{commentPostId}}" viewer="{{user}}" focus-reply-id="{{historyCommentPostId === commentPostId ? historyReplyId : ''}}" focus-reply-input="{{historyCommentPostId === commentPostId && historyReplyInput}}" bind:close="closeHistoryComments" bind:login="commentLogin" bind:changed="commentChanged" />
</view>

<square-composer wx:if="{{composerOpen}}" initial-quote="{{composerQuote}}" quote-owner-id="{{composerQuoteOwnerId}}" bind:close="closeComposer" bind:resumenavigation="syncNavigation" />

<unfollow-confirm wx:if="{{unfollowTarget}}" target="{{unfollowTarget}}" closing="{{unfollowClosing}}" busy="{{unfollowBusy}}" bind:cancel="cancelUnfollowPrompt" bind:confirm="confirmUnfollowPrompt" />
