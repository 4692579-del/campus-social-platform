<import src="../../templates/post-popover.wxml" />
<import src="../../templates/login-sheet.wxml" />
<view class="results-page">
  <view class="results-header" style="padding-top:{{navHeight}}px;">
    <view class="results-search-row search-toolbar">
      <view class="search-toolbar-action search-toolbar-back" bindtap="back" aria-role="button" aria-label="返回搜索"><image class="search-toolbar-back-icon" src="/images/interface/chevron-left.svg" mode="aspectFit" /></view>
      <view class="search-toolbar-field"><search-box value="{{keyword}}" account-id="{{accountId}}" bind:input="onInput" bind:submit="search" bind:removeauthor="removeAuthor" /></view>
    </view>
    <view class="results-tabs" role="tablist"><view wx:for="{{tabs}}" wx:key="key" class="results-tab {{tabIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectTab" aria-role="tab" aria-selected="{{tabIndex === index}}"><text class="results-tab-label">{{item.label}}</text></view><view class="results-indicator" style="{{indicatorStyle}}"></view></view>
  </view>
  <view class="results-viewport"><view class="results-panels" style="left:{{-tabIndex * 100}}%;">
    <scroll-view class="results-panel" scroll-y="{{tabIndex === 0 && !postPopover && !commentPostId && !composerOpen && !loginSheetOpen}}" data-kind="square" bindscrolltolower="loadMore" lower-threshold="160" enhanced show-scrollbar="{{false}}">
      <view wx:if="{{squareError || queryError}}" class="results-error"><text>{{squareError || queryError}}</text><button wx:if="{{needsLogin}}" bindtap="requestLogin">登录</button><button wx:else bindtap="retry">重试</button></view>
      <view wx:if="{{squareLoading && !posts.length}}" class="results-empty">正在搜索动态…</view>
      <square-post wx:for="{{posts}}" wx:key="_id" post="{{item}}" viewer="{{user}}" like-motion="{{true}}" bind:author="viewAuthorProfile" bind:open="openPost" bind:reply="openComments" bind:react="reactPost" bind:more="managePost" bind:quote="quotePost" />
      <view wx:if="{{!squareLoading && !posts.length && !squareError && !queryError}}" class="results-empty"><view>{{queryReady ? '没有找到相关动态' : '输入关键词开始搜索'}}</view><text wx:if="{{queryReady}}">试试其他关键词{{accountId ? '，或移除用户条件' : ''}}</text></view>
      <view wx:if="{{squareMoreLoading}}" class="results-end">正在加载…</view><button wx:elif="{{squareHasMore}}" class="results-more" data-kind="square" bindtap="loadMore">加载更多</button><view wx:elif="{{posts.length}}" class="results-end">已经看到这里了</view>
      <view class="results-bottom"></view>
    </scroll-view>
    <scroll-view class="results-panel" scroll-y="{{tabIndex === 1}}" enhanced show-scrollbar="{{false}}"><view class="results-empty"><view>校园圈搜索暂未开放</view><text>开放后，可在这里搜索校园动态</text></view></scroll-view>
    <scroll-view class="results-panel" scroll-y="{{tabIndex === 2 && !loginSheetOpen}}" data-kind="users" bindscrolltolower="loadMore" lower-threshold="160" enhanced show-scrollbar="{{false}}">
      <view wx:if="{{usersError}}" class="results-error"><text>{{usersError}}</text><button wx:if="{{needsLogin}}" bindtap="requestLogin">登录</button><button wx:else bindtap="retry">重试</button></view>
      <view wx:if="{{usersLoading && !userRows.length}}" class="results-empty">正在搜索用户…</view>
      <view wx:for="{{userRows}}" wx:key="accountId" class="result-user" data-id="{{item.accountId}}" bindtap="openUser" aria-role="button" aria-label="查看{{item.nickname}}的个人主页"><image class="result-user-avatar avatar-outline" src="{{item.avatarFileID || '/images/avatar.png'}}" mode="aspectFill" /><view class="result-user-content"><view class="result-user-heading"><text>{{item.nickname}}</text><image wx:if="{{item.isVerified || item.officialVerified}}" class="result-user-badge {{item.officialVerified ? '' : 'is-student'}}" src="/images/verification/{{item.officialVerified ? 'verified.png' : 'student.svg'}}" mode="aspectFit" aria-label="{{item.officialVerified ? 'Cui官方' : '学生已认证'}}" /></view><view class="result-user-id">@{{item.accountId}}</view><view wx:if="{{item.bio}}" class="result-user-bio">{{item.bio}}</view></view><image class="result-user-arrow" src="/images/interface/chevron-right-muted.svg" /></view>
      <view wx:if="{{!usersLoading && !userRows.length && !usersError}}" class="results-empty">{{queryReady ? '没有找到相关用户' : '输入用户名或ID开始搜索'}}</view>
      <view wx:if="{{usersMoreLoading}}" class="results-end">正在加载…</view><button wx:elif="{{usersHasMore}}" class="results-more" data-kind="users" bindtap="loadMore">加载更多</button><view class="results-bottom"></view>
    </scroll-view>
  </view></view>
</view>
<template is="login-sheet" data="{{loginSheetOpen, loading:loginLoading, error:loginError, cancelText:'暂不登录'}}" />
<comments-sheet wx:if="{{commentPostId}}" id="active-comments" post-id="{{commentPostId}}" viewer="{{user}}" bind:author="viewAuthorProfile" bind:close="closeComments" bind:login="commentLogin" bind:changed="commentChanged" />
<square-composer wx:if="{{composerOpen}}" initial-quote="{{composerQuote}}" quote-owner-id="{{composerQuoteOwnerId}}" bind:close="closeComposer" />
<unfollow-confirm wx:if="{{unfollowTarget}}" target="{{unfollowTarget}}" closing="{{unfollowClosing}}" busy="{{unfollowBusy}}" bind:cancel="cancelUnfollowPrompt" bind:confirm="confirmUnfollowPrompt" />
<template is="post-popover" data="{{menu: postPopover, closing: postPopover.closing, label: postPopover.label, options: postPopover.options, kind: 'post'}}" />
