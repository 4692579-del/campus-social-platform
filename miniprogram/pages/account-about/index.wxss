page { background: #fff; }
.account-page { min-height: 100vh; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); box-sizing: border-box; color: #171b20; background: #fff; }
.account-header { position: relative; background: #fff; }
.header-row { position: absolute; left: 0; right: 0; display: flex; align-items: center; }
.header-title { position: absolute; left: 50%; width: 300rpx; transform: translateX(-50%); text-align: center; font-size: 32rpx; font-weight: 700; white-space: nowrap; }
.account-page .back-button { display: flex; align-items: center; justify-content: center; width: 76rpx; min-width: 0; height: 100%; margin: 0 0 0 12rpx; padding: 0; background: transparent; border: 0; border-radius: 0; line-height: 1; }
.back-button::after, .retry-button::after { border: 0; }
.back-icon { display: block; width: 36rpx; height: 36rpx; }
.account-hero { display: flex; flex-direction: column; align-items: center; padding: 64rpx 36rpx 0; }
.account-avatar { display: block; width: 164rpx; height: 164rpx; border-radius: 50%; background: #f1f3f5; }
.account-nickname { max-width: 100%; margin-top: 24rpx; font-size: 40rpx; line-height: 1.4; font-weight: 700; text-align: center; overflow-wrap: break-word; }
.account-details { padding: 64rpx 36rpx 0; }
.detail-row { display: flex; align-items: flex-start; gap: 26rpx; margin-bottom: 40rpx; }
.detail-icon { flex: 0 0 40rpx; display: flex; align-items: center; justify-content: center; width: 40rpx; height: 44rpx; }
.detail-icon image { display: block; width: 36rpx; height: 36rpx; }
.detail-content { flex: 1; min-width: 0; }
.detail-label { font-size: 31rpx; font-weight: 600; line-height: 1.45; }
.detail-value { color: #687580; font-size: 28rpx; line-height: 1.65; overflow-wrap: break-word; }
.account-id-value { font-variant-numeric: tabular-nums; letter-spacing: 1rpx; }
.account-id-line { display: flex; align-items: center; gap: 12rpx; }
.copy-icon { display: block; width: 28rpx; height: 28rpx; flex-shrink: 0; }
.school-value { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx 14rpx; }
.verified-badge { display: inline-flex; flex-shrink: 0; align-items: center; gap: 6rpx; padding: 2rpx 10rpx; border: 2rpx solid #91adff; border-radius: 28rpx; color: #4775fa; font-size: 21rpx; line-height: 1.5; }
.verified-badge image { display: block; width: 21rpx; height: 21rpx; flex-shrink: 0; }
.school-student-badge { display: block; width: 30rpx; height: 30rpx; flex-shrink: 0; }
.page-notice { padding: 80rpx 36rpx; color: #687580; font-size: 28rpx; text-align: center; line-height: 1.7; }
.account-page .retry-button { width: auto; min-width: 0; margin-top: 24rpx; padding: 0 32rpx; border-radius: 40rpx; background: #4775fa; color: #fff; font-size: 27rpx; line-height: 2.5; }

.account-inline-error { margin: 24rpx 36rpx 0; color: #a44127; font-size: 25rpx; line-height: 1.6; }
