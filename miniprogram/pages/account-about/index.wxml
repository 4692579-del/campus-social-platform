<view class="account-page">
  <view class="account-header" style="height: {{navHeight}}px;">
    <view class="header-row" style="top: {{navTop}}px; height: {{navButtonHeight}}px;">
      <button size="mini" class="back-button" bindtap="back" aria-label="返回个人主页"><image class="back-icon" src="/images/interface/chevron-left.svg" mode="aspectFit" /></button>
      <view class="header-title">关于此账号</view>
    </view>
  </view>
  <view wx:if="{{loading}}" class="page-notice">正在读取账号信息…</view>
  <view wx:elif="{{error && !user}}" class="page-notice">
    <view>{{error}}</view>
    <button size="mini" class="retry-button" bindtap="refresh">重新读取</button>
  </view>
  <block wx:elif="{{user}}">
    <view wx:if="{{error}}" class="account-inline-error"><text>{{error}}</text><button class="retry-button" size="mini" bindtap="refresh">重新读取</button></view>
    <view class="account-hero">
      <image class="account-avatar avatar-outline" src="{{user.avatarFileID || '/images/avatar.png'}}" mode="aspectFill" />
      <view class="account-nickname">{{user.nickname}}</view>
      <view wx:if="{{user.officialVerified}}" class="verified-badge"><image src="/images/verification/verified.png" mode="aspectFit" /><text>Cui官方</text></view>
    </view>
    <view class="account-details">
      <view class="detail-row account-id-row" bindtap="copyAccountId" aria-role="button" aria-label="复制ID账号">
        <view class="detail-icon"><image src="/images/interface/id-card.svg" mode="aspectFit" /></view>
        <view class="detail-content">
          <view class="detail-label">ID账号</view>
          <view class="account-id-line"><text class="detail-value account-id-value">{{user.accountId || '暂未分配，请更新云函数后重试'}}</text><image wx:if="{{user.accountId}}" class="copy-icon" src="/images/interface/copy-muted.svg" mode="aspectFit" /></view>
        </view>
      </view>
      <view class="detail-row">
        <view class="detail-icon"><image src="/images/interface/school.svg" mode="aspectFit" /></view>
        <view class="detail-content">
          <view class="detail-label">所在学校</view>
          <view class="school-value">
            <text class="detail-value">{{schoolText}}</text>
            <view wx:if="{{isVerified}}" class="verified-badge"><image src="/images/verification/verified.png" mode="aspectFit" /><text>已认证</text></view>
          </view>
        </view>
      </view>
      <view class="detail-row">
        <view class="detail-icon"><image src="/images/interface/calendar.svg" mode="aspectFit" /></view>
        <view class="detail-content"><view class="detail-label">加入日期</view><view class="detail-value">{{joinedText}}</view></view>
      </view>
      <view class="detail-row">
        <view class="detail-icon"><image src="/images/interface/at-sign.svg" mode="aspectFit" /></view>
        <view class="detail-content">
          <view class="detail-label">{{changeCount === null || (user.officialVerified && changeCount === 0) ? '用户名更改记录' : changeCount + ' 次用户名更改'}}</view>
          <view class="detail-value">{{user.officialVerified && changeCount === 0 ? '未修改过' : changeCount === null || lastChangedText === '尚无更改记录' ? lastChangedText : '上次更改时间 ' + lastChangedText}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
